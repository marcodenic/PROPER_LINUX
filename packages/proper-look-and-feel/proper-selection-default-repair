"""One-time repair of exact former Proper selection palettes; preserve edits."""
import configparser
import json
import os
from pathlib import Path
import subprocess


def replacement_for(scheme, current, signatures):
    expected = signatures.get(scheme, {})
    return expected.get('new') if current == expected.get('old') else None


def main():
    path = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'kdeglobals'
    config = configparser.ConfigParser(strict=False, interpolation=None)
    config.optionxform = str
    try:
        config.read(path)
        scheme = config.get('General', 'ColorScheme', fallback='')
        current = dict(config['Colors:Selection'])
    except (configparser.Error, KeyError):
        return
    signatures = json.loads(Path('/usr/share/proper-linux/ui/selection-migration.json').read_text())
    updated = replacement_for(scheme, current, signatures)
    if updated is None:
        return
    for key, value in updated.items():
        subprocess.run(['kwriteconfig6', '--file', str(path), '--group', 'Colors:Selection', '--key', key, value], check=True)


if __name__ == '__main__':
    main()
