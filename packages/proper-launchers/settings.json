{
  "$schema": "https://vicinae.com/schemas/config.json",
  "telemetry": { "system_info": false },
  "close_on_focus_loss": false,
  "search_files_in_root": false,
  "theme": {
    "light": { "name": "proper-light", "icon_theme": "auto" },
    "dark": { "name": "proper-dark", "icon_theme": "auto" }
  },
  "launcher_window": {
    "opacity": 0.66,
    "rounding": 16,
    "material": "auto",
    "layer_shell": { "enabled": true, "keyboard_interactivity": "exclusive", "layer": "top" }
  },
  "fallbacks": [
    "shortcuts:sct_properweb1"
  ],
  "favorites": [
    "system:browse-apps",
    "applications:proper-start",
    "applications:chromium-browser",
    "applications:org.kde.dolphin",
    "applications:com.mitchellh.ghostty",
    "files:search",
    "shortcuts:root"
  ],
  "providers": {
    "system": {
      "entrypoints": {
        "browse-apps": {
          "enabled": true,
          "preferences": {
            "sortAlphabetically": true,
            "showHidden": false
          }
        }
      }
    }
  }
}
