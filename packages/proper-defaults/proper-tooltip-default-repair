#!/usr/bin/env bash
set -eu

config_file="${XDG_CONFIG_HOME:-$HOME/.config}/plasmarc"
[[ -f "$config_file" ]] || exit 0
current_delay="$(kreadconfig6 --file "$config_file" --group PlasmaToolTips --key Delay 2>/dev/null || true)"

# Proper previously seeded Delay=0, which disables every Plasma ToolTipArea and
# unintentionally removed task-window previews along with small informational
# labels. Repair only that exact legacy value. Any other value is a user choice
# and remains untouched; kconf_update records this migration once per user.
if [[ "$current_delay" == 0 ]]; then
    kwriteconfig6 --file "$config_file" --group PlasmaToolTips --key Delay 900
fi
