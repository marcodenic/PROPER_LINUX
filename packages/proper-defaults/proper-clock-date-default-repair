#!/usr/bin/env bash
set -eu

state_dir="${XDG_CONFIG_HOME:-$HOME/.config}/proper-linux"
marker="$state_dir/clock-date-policy-v2-applied"
[[ ! -e "$marker" ]] || exit 0

config_file="${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc"
if [[ -f "$config_file" ]]; then
    while read -r containment applet; do
        groups=(
            --file "$config_file"
            --group Containments --group "$containment"
            --group Applets --group "$applet"
            --group Configuration
        )
        legacy_format="$(kreadconfig6 "${groups[@]}" --key Appearance.dateFormat --default __proper_missing__)"
        legacy_custom="$(kreadconfig6 "${groups[@]}" --key Appearance.customDateFormat --default __proper_missing__)"
        current_format="$(kreadconfig6 "${groups[@]}" --group Appearance --key dateFormat --default __proper_missing__)"

        # Proper 0.1-16 through 0.1-29 placed these exact defaults one KConfig
        # group too high. Repair only that signature, and only while the real
        # key is absent. A clock changed through System Settings already has a
        # real Appearance key and is therefore a user choice we leave alone.
        if [[ "$current_format" == __proper_missing__ &&
              "$legacy_format" == custom && "$legacy_custom" == "MMMM d" ]]; then
            kwriteconfig6 "${groups[@]}" --group Appearance --key showSeconds --type bool --notify false
            kwriteconfig6 "${groups[@]}" --group Appearance --key showDate --type bool --notify true
            kwriteconfig6 "${groups[@]}" --group Appearance --key dateFormat --notify custom
            kwriteconfig6 "${groups[@]}" --group Appearance --key customDateFormat --notify "MMMM d"
            for legacy_key in \
                Appearance.showSeconds Appearance.showDate \
                Appearance.dateFormat Appearance.customDateFormat; do
                kwriteconfig6 "${groups[@]}" --key "$legacy_key" --delete --notify ''
            done
        fi
    done < <(awk '
        match($0, /^\[Containments\]\[([0-9]+)\]\[Applets\]\[([0-9]+)\]$/, ids) {
            containment = ids[1]
            applet = ids[2]
            next
        }
        $0 == "plugin=org.kde.plasma.digitalclock" && containment != "" && applet != "" {
            print containment, applet
        }
    ' "$config_file")
fi

mkdir -p "$state_dir"
: >"$marker"
