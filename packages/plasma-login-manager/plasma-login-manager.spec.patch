--- a/plasma-login-manager.spec
+++ b/plasma-login-manager.spec
@@ -4,7 +4,7 @@
 
 Name:           plasma-login-manager
 Version:        6.7.4
-Release:        1%{?dist}
+Release:        1.proper8%{?dist}
 License:        BSD-3-Clause and CC0-1.0 and (GPL-2.0-only or GPL-3.0-only) and GPL-2.0-or-later and LGPL-2.0-or-later and LGPL-2.1-or-later
 Summary:        QML based login manager from KDE
 
@@ -26,6 +26,12 @@ Source12:       plasmalogin.sysusers
 # sample plasmalogin.conf generated with plasmalogin --example-config, and entries commented-out
 Source13:       plasmalogin.conf
 
+# Proper Linux's version-pinned greeter composition.
+Source20:       ProperMain.qml
+Source21:       ProperGridClock.qml
+Source22:       ProperPasswordCells.qml
+Source23:       ProperTokens.qml
+
 # upstream patches
 
 # VirtualTerminal: replace unconditional VT takeover with a bounded wait
@@ -39,6 +42,10 @@ Patch1001:      plasmalogin-environment_file.patch
 ## Workaround for https://pagure.io/fedora-kde/SIG/issue/87
 Patch1002:      plasmalogin-rpmostree-tmpfiles-hack.patch
 
+# Proper Linux downstream greeter entry point, re-audited for every PLM update.
+Patch2000:      proper-login-layout.patch
+
 Provides:       service(graphical-login) = plasmalogin
+Requires:       rsms-inter-fonts = 4.1-3%{?dist}
 
 BuildRequires:  desktop-file-utils
@@ -90,6 +98,10 @@ Plasma Login provides a display manager for KDE Plasma
 
 %prep
 %autosetup -p1
+install -pm 0644 %{SOURCE20} src/frontend/greeter/qml/ProperMain.qml
+install -pm 0644 %{SOURCE21} src/frontend/greeter/qml/ProperGridClock.qml
+install -pm 0644 %{SOURCE22} src/frontend/greeter/qml/ProperPasswordCells.qml
+install -pm 0644 %{SOURCE23} src/frontend/greeter/qml/ProperTokens.qml
 
 
 %conf
@@ -202,6 +215,35 @@ desktop-file-validate %{buildroot}/%{_datadir}/applications/kcm_plasmalogin.desktop
 
 
