<image>
	<!-- The build helper stages the RPM-MD repository here. It is never a
	     runtime repository on the installed system. -->
	<repository type="rpm-md" alias="proper-local">
		<source path="file:///source/repo"/>
	</repository>

	<packages type="image">
		<!-- Proper carries a narrow, version-pinned QML patch for the approved
		     centred PLM composition. The package keeps Fedora's backend and must
		     be rebased whenever Fedora updates Plasma Login Manager. -->
		<package name="plasma-login-manager"/>
		<package name="proper-release"/>
		<package name="proper-branding"/>
		<package name="proper-welcome"/>
		<!-- Fedora consumers require the generic system-logos capability, not
		     Fedora's official marks.  Use the upstream compatibility package and
		     let proper-branding own every selected visible identity. -->
		<package name="generic-logos"/>
		<package name="proper-look-and-feel"/>
		<package name="proper-defaults"/>
		<package name="proper-launchers"/>
		<package name="proper-terminal"/>
		<package name="proper-apps"/>
		<package name="proper-appearance"/>
		<package name="chromium"/>
		<package name="kamoso"/>
		<package name="krdc"/>
		<package name="krfb"/>
	</packages>
	<!-- Keep the default image lean; office applications belong in the
	     future catalogue, not the installed Proper desktop. -->
	<packages type="image" patternType="plusRecommended" profiles="KDE-Desktop,KDE-Mobile">
		<!-- Explicit Phase 6 curation: these applications and dependency stacks
		     must not enter the installed image through Fedora recommendations. -->
		<ignore name="libreoffice*"/>
		<ignore name="kdepim*"/>
		<ignore name="akonadi*"/>
		<ignore name="mariadb*"/>
		<ignore name="korganizer*"/>
		<ignore name="kmail*"/>
		<ignore name="kleopatra*"/>
		<ignore name="akregator*"/>
		<ignore name="kaddressbook*"/>
		<ignore name="kontact*"/>
		<ignore name="kmines"/>
		<ignore name="kpat"/>
		<ignore name="kmahjongg"/>
		<ignore name="neochat"/>
		<!-- Fedora 44 KDE owns installed first boot through plasma-setup.
		     Legacy initial-setup conflicts with Plasma Login Manager's setup
		     autologin and must not enter the image. -->
		<ignore name="initial-setup*"/>
		<ignore name="plasma-welcome*"/>
		<ignore name="fedora-media-writer*"/>
		<ignore name="mediawriter*"/>
		<ignore name="fedora-logos"/>
		<ignore name="elisa*"/>
		<ignore name="dragonplayer*"/>
		<ignore name="kolourpaint*"/>
		<ignore name="skanpage*"/>
		<ignore name="qrca*"/>
		<!-- Phase 7 curation: Proper owns the five approved wallpapers and
		     keeps optional cloud, container, and vendor-printer stacks in the
		     catalogue instead of every default installation. -->
		<ignore name="plasma-workspace-wallpapers"/>
		<ignore name="desktop-backgrounds-kde"/>
		<ignore name="f44-backgrounds*"/>
		<ignore name="awscli*"/>
		<ignore name="python3-boto*"/>
		<ignore name="python3-s3transfer*"/>
		<ignore name="podman*"/>
		<ignore name="skopeo*"/>
		<ignore name="toolbox*"/>
		<ignore name="hplip*"/>
		<ignore name="gutenprint*"/>
	</packages>
</image>
