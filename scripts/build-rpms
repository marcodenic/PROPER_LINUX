#!/usr/bin/env bash
# Build the versioned Proper RPMs and expose them as a small local RPM-MD repo.
set -Eeuo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
output_root="${PROPER_OUTPUT_DIR:-"$project_root/../proper-linux-build"}"
rpm_root="$output_root/rpms"
repo_root="$output_root/repo"
source_cache="$output_root/sources"

download_verified() {
  local url="$1" dest="$2" expected="$3"
  mkdir -p "$(dirname "$dest")"
  [[ -s "$dest" ]] || curl -L --fail --silent --show-error "$url" -o "$dest"
  [[ "$(sha256sum "$dest" | awk '{print $1}')" == "$expected" ]] || { printf 'Checksum mismatch: %s\n' "$dest" >&2; exit 1; }
}

for binary in rpmbuild curl rpm2cpio cpio patch podman; do
  command -v "$binary" >/dev/null 2>&1 || { printf 'Required command missing: %s\n' "$binary" >&2; exit 1; }
done

"$project_root/scripts/validate-plasma-theme"
"$project_root/scripts/validate-arrival"
"$project_root/scripts/validate-typography"

# Container builds can preserve numeric archive ownership in their bind-mounted
# output.  In rootless Podman those owners are valid subordinate UIDs but the
# calling host user cannot remove their directories with a plain rm.  Clean in
# the same user namespace so an interrupted build is always restartable. A
# bounded resume retains already completed package trees after an outer process
# loses its attachment to a still-running Podman build.
if [[ "${PROPER_RPM_RESUME:-0}" != 1 ]]; then
  if [[ "$(podman info --format '{{.Host.Security.Rootless}}')" == "true" ]]; then
    podman unshare rm -rf -- "$rpm_root" "$repo_root"
  else
    rm -rf -- "$rpm_root" "$repo_root"
  fi
fi
mkdir -p "$rpm_root" "$repo_root" "$source_cache"

default_packages="plasma-login-manager plasma-desktop proper-release proper-branding proper-welcome proper-look-and-feel proper-agent-status proper-defaults proper-launchers proper-terminal proper-apps proper-appearance"
read -r -a packages_to_build <<<"${PROPER_RPM_PACKAGES:-$default_packages}"
for package in "${packages_to_build[@]}"; do
  package_root="$project_root/packages/$package"
  spec="$package_root/$package.spec"
  mkdir -p "$rpm_root/$package"/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS}
  if [[ "$package" == plasma-login-manager ]]; then
    plm_srpm="$source_cache/plasma-login-manager-6.7.4-1.fc44.src.rpm"
    plm_sources="$(mktemp -d "$source_cache/plasma-login-manager-6.7.4-1.fc44-proper.XXXXXX")"
    download_verified https://download.fedoraproject.org/pub/fedora/linux/updates/44/Everything/source/tree/Packages/p/plasma-login-manager-6.7.4-1.fc44.src.rpm "$plm_srpm" d8139ab3fdac94c5361cb0823e229d421d9385efb3dd26e54fd11442eed7ffa6
    (cd "$plm_sources" && rpm2cpio "$plm_srpm" | cpio -idm --quiet)
    install -m 0644 "$package_root/ProperMain.qml" "$plm_sources/ProperMain.qml"
    install -m 0644 "$package_root/ProperGridClock.qml" "$plm_sources/ProperGridClock.qml"
    install -m 0644 "$package_root/ProperPasswordCells.qml" "$plm_sources/ProperPasswordCells.qml"
    install -m 0644 "$package_root/ProperTokens.qml" "$plm_sources/ProperTokens.qml"
    install -m 0644 "$package_root/proper-login-layout.patch" "$plm_sources/proper-login-layout.patch"
    (cd "$plm_sources" && patch --batch --forward -p1 < "$package_root/plasma-login-manager.spec.patch")
    podman run --rm \
      --volume "$plm_sources:/src:z" \
      --volume "$rpm_root/$package:/out:z" \
      quay.io/fedora/fedora:44@sha256:c095fee5833adde3e7fb9bdfc30023d34b884a327e8019d597c708cbe8d8dd13 \
      bash -lc "dnf -y install rpm-build dnf5-plugins >/dev/null && dnf -y builddep /src/plasma-login-manager.spec >/dev/null && mkdir -p /out/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS} && cd /src && rpmbuild -bb --define '_tmppath /tmp' --define '_topdir /out' --define '_sourcedir /src' --define '_smp_mflags -j8' plasma-login-manager.spec"
  elif [[ "$package" == plasma-desktop ]]; then
    plasma_desktop_srpm="$source_cache/plasma-desktop-6.7.4-1.fc44.src.rpm"
    plasma_desktop_sources="$(mktemp -d "$source_cache/plasma-desktop-6.7.4-1.fc44-proper.XXXXXX")"
    download_verified https://download.fedoraproject.org/pub/fedora/linux/updates/44/Everything/source/tree/Packages/p/plasma-desktop-6.7.4-1.fc44.src.rpm "$plasma_desktop_srpm" bc3e4d042be57b1d3d6edac10203f85ddb8690ae36f1ce98368ed53f4f73166a
    (cd "$plasma_desktop_sources" && rpm2cpio "$plasma_desktop_srpm" | cpio -idm --quiet)
    install -m 0644 "$package_root/proper-task-loading-indicator.patch" "$plasma_desktop_sources/proper-task-loading-indicator.patch"
    (cd "$plasma_desktop_sources" && patch --batch --forward -p1 < "$package_root/plasma-desktop.spec.patch")
    podman run --rm \
      --volume "$plasma_desktop_sources:/src:z" \
      --volume "$rpm_root/$package:/out:z" \
      quay.io/fedora/fedora:44@sha256:c095fee5833adde3e7fb9bdfc30023d34b884a327e8019d597c708cbe8d8dd13 \
      bash -lc "dnf -y install rpm-build dnf5-plugins >/dev/null && dnf -y builddep /src/plasma-desktop.spec >/dev/null && mkdir -p /out/{BUILD,BUILDROOT,RPMS,SOURCES,SPECS,SRPMS} && cd /src && rpmbuild -bb --define '_tmppath /tmp' --define '_topdir /out' --define '_sourcedir /src' --define '_smp_mflags -j8' plasma-desktop.spec"
  elif [[ "$package" == proper-terminal ]]; then
    download_verified https://release.files.ghostty.org/1.3.1/ghostty-1.3.1.tar.gz "$source_cache/ghostty-1.3.1.tar.gz" 3349d25600ffbda281197a18314f7d18791969cffe9474f0ff16a45a9ebfccdb
    download_verified https://ziglang.org/download/0.15.2/zig-x86_64-linux-0.15.2.tar.xz "$source_cache/zig-x86_64-linux-0.15.2.tar.xz" 02aa270f183da276e5b5920b1dac44a63f1a49e55050ebde3aecc9eb82f93239
    [[ -s "$source_cache/ghostty-1.3.1.tar.gz.minisig" ]] || curl -L --fail --silent --show-error https://release.files.ghostty.org/1.3.1/ghostty-1.3.1.tar.gz.minisig -o "$source_cache/ghostty-1.3.1.tar.gz.minisig"
    [[ -s "$source_cache/zig-x86_64-linux-0.15.2.tar.xz.minisig" ]] || curl -L --fail --silent --show-error https://ziglang.org/download/0.15.2/zig-x86_64-linux-0.15.2.tar.xz.minisig -o "$source_cache/zig-x86_64-linux-0.15.2.tar.xz.minisig"
    cp "$source_cache"/ghostty-1.3.1.tar.gz* "$package_root/"
    cp "$source_cache"/zig-x86_64-linux-0.15.2.tar.xz* "$package_root/"
    podman build --quiet --tag proper-ghostty-builder-full --file "$project_root/image/Containerfile.ghostty" "$project_root/image" >/dev/null
    podman run --rm --volume "$package_root:/src:z" --volume "$rpm_root/$package:/out:z" proper-ghostty-builder-full bash -lc "cd /src && rpmbuild -bb --define '_tmppath /tmp' --define '_topdir /out' --define '_sourcedir /src' proper-terminal.spec && find /out -type f -name '*.rpm' -exec cp {} /out/ \\;"
  elif [[ "$package" == proper-launchers ]]; then
    download_verified https://github.com/vicinaehq/vicinae/archive/01cd7cb4936d9cb14272091623da85e7c880f0dc.tar.gz "$source_cache/vicinae-0.24.0-source.tar.gz" ee4e80d6e69193820b294a43a008794d8761cda9914256c32aed3be091f5c0e3
    cp "$source_cache/vicinae-0.24.0-source.tar.gz" "$package_root/01cd7cb4936d9cb14272091623da85e7c880f0dc.tar.gz"
    podman build --quiet --tag proper-vicinae-builder --file "$project_root/image/Containerfile.vicinae" "$project_root/image" >/dev/null
    podman run --rm --volume "$package_root:/src:z" --volume "$rpm_root/$package:/out:z" proper-vicinae-builder bash -lc "cd /src && rpmbuild -bb --define '_tmppath /tmp' --define '_topdir /out' --define '_sourcedir /src' proper-launchers.spec"
  elif [[ "$package" == proper-apps || "$package" == proper-appearance || "$package" == proper-welcome ]]; then
    podman build --quiet --tag proper-apps-builder --file "$project_root/image/Containerfile.ghostty" "$project_root/image" >/dev/null
    podman run --rm --volume "$project_root:/repo:z" --volume "$rpm_root/$package:/out:z" proper-apps-builder bash -lc "cd /repo/packages/$package && rpmbuild -bb --define '_tmppath /tmp' --define '_topdir /out' --define '_sourcedir /repo/packages/$package' $package.spec"
  else
    rpmbuild -bb --define "_tmppath /tmp" --define "_topdir $rpm_root/$package" --define "_sourcedir $package_root" "$spec"
  fi
done

while IFS= read -r -d '' rpm; do
  install -m 0644 "$rpm" "$repo_root/$(basename "$rpm")"
done < <(find "$rpm_root" -type f -name '*.rpm' -print0)
if command -v createrepo_c >/dev/null 2>&1; then
  createrepo_c --quiet "$repo_root"
elif command -v podman >/dev/null 2>&1; then
  builder_image="localhost/proper-linux-kiwi-builder:fedora44"
  podman build --tag "$builder_image" --file "$project_root/image/Containerfile" "$project_root/image"
  podman run --rm --volume "$repo_root:/repo:z" "$builder_image" createrepo_c --quiet /repo
else
  printf 'Required command missing: createrepo_c (and no Podman fallback is available)\n' >&2
  exit 1
fi
printf 'Built local Proper repository: %s\n' "$repo_root"
