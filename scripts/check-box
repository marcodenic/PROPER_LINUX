#!/usr/bin/env bash
# Report host prerequisites for a Proper Linux KIWI build and QEMU review.
set -Eeuo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
report_path="${1:-"${TMPDIR:-/tmp}/proper-linux-build-environment.md"}"
timestamp="$(date --iso-8601=seconds)"
arch="$(uname -m)"
kernel="$(uname -r)"
os_name="$(. /etc/os-release; printf '%s %s' "${NAME:-unknown}" "${VERSION_ID:-unknown}")"
memory="$(free -h | awk '/^Mem:/ {print $2 " total; " $7 " available"}')"
storage="$(df -h "$project_root" | awk 'NR == 2 {print $4 " free of " $2 " at " $6}')"
cpu_model="$(lscpu | awk -F: '/Model name:/ {sub(/^[[:space:]]+/, "", $2); print $2; exit}')"
virt_flag="absent"
grep -qwE 'vmx|svm' /proc/cpuinfo && virt_flag="present"
kvm_state="missing"
if [[ -e /dev/kvm ]]; then
  if [[ -r /dev/kvm && -w /dev/kvm ]]; then kvm_state="available"; else kvm_state="present but inaccessible"; fi
fi

binary_version() {
  local binary="$1"
  if command -v "$binary" >/dev/null 2>&1; then
    "$binary" --version 2>&1 | head -n1
  else
    printf 'not installed'
  fi
}

mkdir -p "$(dirname "$report_path")"
cat >"$report_path" <<EOF
# Proper Linux build environment

Last checked: $timestamp

This report is generated by the host prerequisite check. Re-run it after host changes.

| Check | Result |
| --- | --- |
| Host OS | $os_name |
| Kernel | $kernel |
| Architecture | $arch |
| CPU | $cpu_model |
| CPU virtualisation flag | $virt_flag |
| Memory | $memory |
| Project filesystem | $storage |
| /dev/kvm | $kvm_state |
| QEMU | $(binary_version qemu-system-x86_64) |
| UEFI firmware | $(rpm -q edk2-ovmf 2>&1 || true) |
| Podman | $(binary_version podman) |
| Docker | $(binary_version docker) |
| KIWI | $(binary_version kiwi-ng) |
| RPM build | $(rpm -q rpm-build 2>&1 || true) |
| ISO/checksum tools | $(rpm -q xorriso coreutils 2>&1 || true) |

## Output and review convention

- Build inputs remain in Git; ISO images, VM disks, caches, and logs go in a directory outside Git (the scripts default to ../proper-linux-build).
- scripts/run-vm exposes the graphical VM through a local QEMU window. Capture PM evidence with the host screenshot tool or the VM display capture facility once QEMU/KVM is available.

## Current blockers

The environment-check command records availability rather than installing packages. A build requires KIWI, QEMU, OVMF, xorriso, an enabled container/runtime path if used, and privileged image-build access. Graphical acceptance additionally requires readable and writable /dev/kvm.
EOF

printf 'Wrote %s\n' "$report_path"
