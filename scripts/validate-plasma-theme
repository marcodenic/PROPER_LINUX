#!/usr/bin/env bash
# Reject malformed Plasma SVG assets and rectangular shell-surface regressions.
# Panel masks clip contrast/blur to the rounded frame. Panel art follows
# Breeze's tiled-centre contract with one equal-opacity fill per frame slice.
set -Eeuo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
style_root="$project_root/packages/proper-look-and-feel/proper"
metadata="$style_root/metadata.json"
heading_asset="$style_root/widgets/plasmoidheading.svg"
spec="$project_root/packages/proper-look-and-feel/proper-look-and-feel.spec"
tokens="$project_root/packages/proper-look-and-feel/tokens.yaml"
plasma_defaults="$project_root/packages/proper-defaults/plasmarc"
defaults_spec="$project_root/packages/proper-defaults/proper-defaults.spec"
kwin_defaults="$project_root/packages/proper-defaults/kwinrc"
shell_defaults="$project_root/packages/proper-defaults/plasmashellrc"
default_kdeglobals="$project_root/packages/proper-defaults/kdeglobals"
desktop_layout="$project_root/packages/proper-look-and-feel/proper-desktop-layout.js"
panel_migration="$project_root/packages/proper-look-and-feel/com.properlinux.desktop/contents/updates/00-migrate-proper-panel-v1.js"
status_migration="$project_root/packages/proper-look-and-feel/com.properlinux.desktop/contents/updates/01-migrate-status-shade-edge-v1.js"
semantic_generator="$project_root/packages/proper-look-and-feel/generate-semantic-assets.py"
tooltip_update="$project_root/packages/proper-defaults/proper-defaults.upd"
light_icon_index="$project_root/packages/proper-look-and-feel/proper.index.theme"
dark_icon_index="$project_root/packages/proper-look-and-feel/proper-dark.index.theme"
dark_look_defaults="$project_root/packages/proper-look-and-feel/com.properlinux.dark.desktop/contents/defaults"
light_look_defaults="$project_root/packages/proper-look-and-feel/com.properlinux.light.desktop/contents/defaults"
midnight_look_defaults="$project_root/packages/proper-look-and-feel/com.properlinux.midnight.desktop/contents/defaults"
task_asset="$style_root/widgets/tasks.svg"
panel_asset="$style_root/widgets/panel-background.svg"
solid_panel_asset="$style_root/solid/widgets/panel-background.svg"
popup_asset="$style_root/dialogs/background.svg"
solid_popup_asset="$style_root/solid/dialogs/background.svg"
task_loading_patch="$project_root/packages/plasma-desktop/proper-task-loading-indicator.patch"
control_generator="$project_root/packages/proper-look-and-feel/generate-plasma-controls.py"
panel_generator="$project_root/packages/proper-look-and-feel/generate-panel-material.py"
generated_controls="$(mktemp -d /tmp/proper-plasma-controls.XXXXXX)"
generated_panel="$(mktemp -d /tmp/proper-panel-material.XXXXXX)"
generated_semantic="$(mktemp -d /tmp/proper-semantic.XXXXXX)"
trap 'rm -rf -- "$generated_controls" "$generated_panel" "$generated_semantic"' EXIT

for binary in python3 xmllint; do
  command -v "$binary" >/dev/null 2>&1 || {
    printf 'Required command missing: %s\n' "$binary" >&2
    exit 1
  }
done

python3 "$control_generator" "$tokens" "$generated_controls"
python3 "$panel_generator" "$tokens" "$generated_panel"
python3 "$semantic_generator" "$tokens" "$generated_semantic"
dark_scheme="$generated_semantic/Proper.colors"
cmp "$generated_panel/panel-background.svg" "$panel_asset"
cmp "$generated_panel/solid-panel-background.svg" "$solid_panel_asset"
cmp "$generated_panel/popup-background.svg" "$popup_asset"
cmp "$generated_panel/solid-popup-background.svg" "$solid_popup_asset"
cmp "$generated_semantic/proper-anaconda.css" \
  "$project_root/packages/proper-branding/proper-anaconda.css"
cmp "$generated_semantic/ProperTokens.qml" \
  "$project_root/packages/plasma-login-manager/ProperTokens.qml"
grep -Fq 'background = "#141a22"' "$generated_semantic/proper-dark.toml"
grep -Fq 'border = "#282f38"' "$generated_semantic/proper-dark.toml"
grep -A12 '^\[Colors:Header\]$' "$generated_semantic/Proper.colors" | \
  grep -Fq 'BackgroundNormal=20,26,34'

while IFS= read -r -d '' asset; do
  xmllint --noout "$asset"
done < <(find "$style_root" -type f -name '*.svg' -print0)

while IFS= read -r -d '' asset; do
  xmllint --noout "$asset"
done < <(find "$generated_controls" -type f -name '*.svg' -print0)

for asset in button line lineedit listitem slider switch tabbar viewitem; do
  [[ -f "$generated_controls/$asset.svg" ]] || {
    printf 'Generated Plasma control is missing: %s.svg\n' "$asset" >&2
    exit 1
  }
done

for state in normal hover pressed section; do
  for slice in center top bottom left right topleft topright bottomleft bottomright; do
    [[ "$(xmllint --xpath "count(//*[@id='$state-$slice'])" "$generated_controls/listitem.svg")" == 1 ]] || {
      printf 'Proper listitem is missing %s-%s.\n' "$state" "$slice" >&2
      exit 1
    }
  done
done

for state in normal hover selected selected+hover; do
  for slice in center top bottom left right topleft topright bottomleft bottomright; do
    [[ "$(xmllint --xpath "count(//*[@id='$state-$slice'])" "$generated_controls/viewitem.svg")" == 1 ]] || {
      printf 'Proper viewitem is missing %s-%s.\n' "$state" "$slice" >&2
      exit 1
    }
  done
done

for state in normal hover pressed focus toolbutton-hover toolbutton-pressed toolbutton-focus; do
  for slice in center top bottom left right topleft topright bottomleft bottomright; do
    [[ "$(xmllint --xpath "count(//*[@id='$state-$slice'])" "$generated_controls/button.svg")" == 1 ]] || {
      printf 'Proper button is missing %s-%s.\n' "$state" "$slice" >&2
      exit 1
    }
  done
done

for state in base hover focus focusframe; do
  for slice in center top bottom left right topleft topright bottomleft bottomright; do
    [[ "$(xmllint --xpath "count(//*[@id='$state-$slice'])" "$generated_controls/lineedit.svg")" == 1 ]] || {
      printf 'Proper line edit is missing %s-%s.\n' "$state" "$slice" >&2
      exit 1
    }
  done
done

# Every generated rounded control frame is composed from nine independently
# rendered slices. Keep the five rectilinear slices and four corner groups on
# one fill/class/opacity, and bleed corner fills into both slice interfaces.
check_control_frame() {
  local asset="$1" prefix="$2"
  local frame_opacity frame_class matched_rects matched_corners corner_bleeds
  frame_opacity="$(xmllint --xpath "string(//*[@id='$prefix-center']/@fill-opacity)" "$asset")"
  frame_class="$(xmllint --xpath "string(//*[@id='$prefix-center']/@class)" "$asset")"
  matched_rects="$(xmllint --xpath "count(//*[@id='$prefix-center' or @id='$prefix-top' or @id='$prefix-bottom' or @id='$prefix-left' or @id='$prefix-right'][@fill-opacity='$frame_opacity' and @class='$frame_class'])" "$asset")"
  matched_corners="$(xmllint --xpath "count(//*[@id='$prefix-topleft' or @id='$prefix-topright' or @id='$prefix-bottomleft' or @id='$prefix-bottomright'][@opacity='$frame_opacity'])" "$asset")"
  corner_bleeds="$(xmllint --xpath "count(//*[@id='$prefix-topleft' or @id='$prefix-topright' or @id='$prefix-bottomleft' or @id='$prefix-bottomright']/*[local-name()='rect' and @class='$frame_class'])" "$asset")"
  [[ -n "$frame_opacity" && -n "$frame_class" && "$matched_rects" == 5 &&
     "$matched_corners" == 4 && "$corner_bleeds" == 8 ]] || {
    printf '%s frame %s must use one seam-safe fill across all nine slices.\n' "$asset" "$prefix" >&2
    exit 1
  }
}

for state in normal hover pressed section; do
  check_control_frame "$generated_controls/listitem.svg" "$state"
done
for state in normal hover selected selected+hover; do
  check_control_frame "$generated_controls/viewitem.svg" "$state"
done
for state in normal hover pressed focus toolbutton-hover toolbutton-pressed toolbutton-focus mask-normal shadow; do
  check_control_frame "$generated_controls/button.svg" "$state"
done
for state in base hover focus focusframe; do
  check_control_frame "$generated_controls/lineedit.svg" "$state"
done
for state in north-active-tab south-active-tab east-active-tab west-active-tab; do
  check_control_frame "$generated_controls/tabbar.svg" "$state"
done
while IFS= read -r -d '' asset; do
  [[ "$(xmllint --xpath "count(//*[contains(@id, 'hint-compose-over-border')])" "$asset")" == 0 ]] || {
    printf '%s must not double-composite a translucent control centre beneath filled borders.\n' "$asset" >&2
    exit 1
  }
done < <(find "$generated_controls" -type f -name '*.svg' -print0)

# Plasma's TextField expands hover/focus layers by their FrameSvg margins.
# Those overlay margins must be effectively zero or a focused password field
# will paint outside its owning Networks row. The base keeps normal padding.
[[ "$(xmllint --xpath "string(//*[@id='base-hint-left-margin']/@width)" "$generated_controls/lineedit.svg")" == 7 ]] || {
  printf 'Proper line-edit base padding must remain seven pixels.\n' >&2
  exit 1
}
for state in hover focus focusframe; do
  for side in left right; do
    [[ "$(xmllint --xpath "string(//*[@id='$state-hint-$side-margin']/@width)" "$generated_controls/lineedit.svg")" == 0.001 ]] || {
      printf 'Proper line-edit %s %s overlay margin must stay inside the control.\n' "$state" "$side" >&2
      exit 1
    }
  done
  for side in top bottom; do
    [[ "$(xmllint --xpath "string(//*[@id='$state-hint-$side-margin']/@height)" "$generated_controls/lineedit.svg")" == 0.001 ]] || {
      printf 'Proper line-edit %s %s overlay margin must stay inside the control.\n' "$state" "$side" >&2
      exit 1
    }
  done
done

for state in groove groove-highlight; do
  for slice in center top bottom left right topleft topright bottomleft bottomright; do
    [[ "$(xmllint --xpath "count(//*[@id='$state-$slice'])" "$generated_controls/slider.svg")" == 1 ]] || {
      printf 'Proper slider is missing %s-%s.\n' "$state" "$slice" >&2
      exit 1
    }
  done
done

for element in inactive-left inactive-center inactive-right active-left active-center active-right handle handle-hover handle-focus handle-pressed; do
  [[ "$(xmllint --xpath "count(//*[@id='$element'])" "$generated_controls/switch.svg")" == 1 ]] || {
    printf 'Proper switch is missing %s.\n' "$element" >&2
    exit 1
  }
done
[[ "$(xmllint --xpath "string(//*[@id='hint-bar-size']/@width)" "$generated_controls/switch.svg")" == 38 &&
   "$(xmllint --xpath "string(//*[@id='hint-bar-size']/@height)" "$generated_controls/switch.svg")" == 16 ]] || {
  printf 'Proper switch track must retain the reviewed 38x16 contract.\n' >&2
  exit 1
}
[[ "$(xmllint --xpath "count(//*[@id='inactive-left' or @id='inactive-right' or @id='active-left' or @id='active-right'][local-name()='path'])" "$generated_controls/switch.svg")" == 4 ]] || {
  printf 'Proper switch end caps must be half-pill paths, not doubly-rounded frame slices.\n' >&2
  exit 1
}
[[ "$(xmllint --xpath "string(//*[@id='handle']/@r)" "$generated_controls/switch.svg")" == 8 ]] || {
  printf 'Proper switch handle must remain balanced inside the 16-pixel track.\n' >&2
  exit 1
}

for direction in north south east west; do
  for slice in center top bottom left right topleft topright bottomleft bottomright; do
    [[ "$(xmllint --xpath "count(//*[@id='$direction-active-tab-$slice'])" "$generated_controls/tabbar.svg")" == 1 ]] || {
      printf 'Proper tabbar is missing %s-active-tab-%s.\n' "$direction" "$slice" >&2
      exit 1
    }
  done
done

[[ "$(xmllint --xpath "string(//*[@id='pressed-center']/@fill-opacity)" "$generated_controls/listitem.svg")" == 0.150 ]] || {
  printf 'Proper selected list rows must retain the reviewed restrained fill.\n' >&2
  exit 1
}

surface_assets=(
  "$panel_asset"
  "$solid_panel_asset"
  "$popup_asset"
  "$solid_popup_asset"
)

package_version="$(awk '$1 == "Version:" { print $2; exit }' "$spec")"
package_release="$(awk '$1 == "Release:" { print $2; exit }' "$spec")"
package_release="${package_release%%%*}"
style_version="$(sed -n 's/^[[:space:]]*"Version": "\([^"]*\)",$/\1/p' "$metadata")"
expected_style_version="$package_version.$package_release"
[[ "$style_version" == "$expected_style_version" ]] || {
  printf 'Plasma Style metadata version is %s; expected %s from the RPM version and release.\n' \
    "$style_version" "$expected_style_version" >&2
  printf 'Bump the style version with the RPM release so Plasma cannot reuse stale SVG caches.\n' >&2
  exit 1
}
for look_metadata in \
  "$project_root/packages/proper-look-and-feel/com.properlinux.dark.desktop/metadata.json" \
  "$project_root/packages/proper-look-and-feel/com.properlinux.light.desktop/metadata.json" \
  "$project_root/packages/proper-look-and-feel/com.properlinux.midnight.desktop/metadata.json"; do
  grep -Fq "\"Version\": \"$expected_style_version\"" "$look_metadata" || {
    printf 'Global Theme metadata does not match the owning RPM: %s\n' "$look_metadata" >&2
    exit 1
  }
done

required_ids=(
  center top bottom left right
  topleft topright bottomleft bottomright
  mask-center mask-top mask-bottom mask-left mask-right
  mask-topleft mask-topright mask-bottomleft mask-bottomright
)

for asset in "${surface_assets[@]}"; do
  for required_id in "${required_ids[@]}"; do
    count="$(xmllint --xpath "count(//*[@id='$required_id'])" "$asset")"
    [[ "$count" == 1 ]] || {
      printf '%s must define id=%s exactly once; found %s.\n' \
        "$asset" "$required_id" "$count" >&2
      exit 1
    }
  done
done

for asset in "${surface_assets[@]}"; do
  [[ "$(xmllint --xpath "count(//*[@id = 'hint-compose-over-border'])" "$asset")" == 0 ]] || {
    printf '%s must not double-composite its centre beneath filled borders.\n' "$asset" >&2
    exit 1
  }
  [[ "$(xmllint --xpath "count(//*[@id = 'hint-tile-center'])" "$asset")" == 1 ]] || {
    printf '%s must use Plasma\x27s standard tiled-centre panel contract.\n' "$asset" >&2
    exit 1
  }
  centre_opacity="$(xmllint --xpath "string(//*[@id='center']/@fill-opacity)" "$asset")"
  matched_edge_fills="$(xmllint --xpath "count(//*[@id='top' or @id='bottom' or @id='left' or @id='right']/*[1][@fill-opacity='$centre_opacity'])" "$asset")"
  matched_corner_groups="$(xmllint --xpath "count(//*[@id='topleft' or @id='topright' or @id='bottomleft' or @id='bottomright']/*[1][@opacity='$centre_opacity'])" "$asset")"
  [[ "$matched_edge_fills" == 4 && "$matched_corner_groups" == 4 ]] || {
    printf '%s must use centre opacity %s on all eight border fills.\n' "$asset" "$centre_opacity" >&2
    exit 1
  }
  [[ "$(xmllint --xpath "count(//*[@id='topleft' or @id='topright' or @id='bottomleft' or @id='bottomright']/*[1]/*[local-name()='rect'])" "$asset")" == 8 ]] || {
    printf '%s must bleed each corner fill into both adjoining slice edges.\n' "$asset" >&2
    exit 1
  }
  rim_color="$(xmllint --xpath "string(//*[@id='top']/*[2]/@fill)" "$asset")"
  rim_opacity="$(xmllint --xpath "string(//*[@id='top']/*[2]/@fill-opacity)" "$asset")"
  matched_edge_rims="$(xmllint --xpath "count(//*[@id='top' or @id='bottom' or @id='left' or @id='right']/*[2][@fill='$rim_color' and @fill-opacity='$rim_opacity'])" "$asset")"
  matched_corner_rim_groups="$(xmllint --xpath "count(//*[@id='topleft' or @id='topright' or @id='bottomleft' or @id='bottomright']/*[2][@opacity='$rim_opacity'])" "$asset")"
  matched_corner_rim_bleeds="$(xmllint --xpath "count(//*[@id='topleft' or @id='topright' or @id='bottomleft' or @id='bottomright']/*[2]/*[local-name()='rect' and @fill='$rim_color'])" "$asset")"
  matched_corner_rim_paths="$(xmllint --xpath "count(//*[starts-with(@id, 'rim-') and (@stroke='$rim_color' or @fill='$rim_color')])" "$asset")"
  [[ "$matched_edge_rims" == 4 && "$matched_corner_rim_groups" == 4 &&
     "$matched_corner_rim_bleeds" == 8 && "$matched_corner_rim_paths" == 4 ]] || {
    printf '%s must post-composite one identical seam-safe rim around every slice.\n' "$asset" >&2
    exit 1
  }
  [[ "$(xmllint --xpath "count(//*[local-name()='linearGradient'])" "$asset")" == 0 ]] || {
    printf '%s must not vary the surface rim treatment between slices.\n' "$asset" >&2
    exit 1
  }
  [[ "$(xmllint --xpath "count(//*[@id='mask-topleft' or @id='mask-topright' or @id='mask-bottomleft' or @id='mask-bottomright']/*[local-name()='rect'])" "$asset")" == 8 ]] || {
    printf '%s must bleed every mask corner into both adjoining slices.\n' "$asset" >&2
    exit 1
  }
done

popup_fill="$(xmllint --xpath "string(//*[@id='center']/@fill)" "$popup_asset")"
panel_fill="$(xmllint --xpath "string(//*[@id='center']/@fill)" "$panel_asset")"
popup_opacity="$(xmllint --xpath "string(//*[@id='center']/@fill-opacity)" "$popup_asset")"
panel_opacity="$(xmllint --xpath "string(//*[@id='center']/@fill-opacity)" "$panel_asset")"
solid_popup_fill="$(xmllint --xpath "string(//*[@id='center']/@fill)" "$solid_popup_asset")"
solid_panel_fill="$(xmllint --xpath "string(//*[@id='center']/@fill)" "$solid_panel_asset")"
solid_popup_opacity="$(xmllint --xpath "string(//*[@id='center']/@fill-opacity)" "$solid_popup_asset")"
solid_panel_opacity="$(xmllint --xpath "string(//*[@id='center']/@fill-opacity)" "$solid_panel_asset")"
[[ "$popup_fill" == "$panel_fill" && "$popup_opacity" == "$panel_opacity" &&
   "$solid_popup_fill" == "$solid_panel_fill" && "$solid_popup_opacity" == "$solid_panel_opacity" ]] || {
  printf 'Proper panel popups must use the shelf material in translucent and dense states.\n' >&2
  exit 1
}

xmllint --noout "$heading_asset"
for prefix in header footer; do
  for slice in center top bottom left right topleft topright bottomleft bottomright; do
    [[ "$(xmllint --xpath "count(//*[@id='$prefix-$slice'])" "$heading_asset")" == 1 ]] || {
      printf '%s is missing %s-%s.\n' "$heading_asset" "$prefix" "$slice" >&2
      exit 1
    }
  done
done
[[ "$(xmllint --xpath "count(//*[@id='header-top' or @id='header-left' or @id='header-right']/*[2][@fill='#a6afbd' and @fill-opacity='0.18'])" "$heading_asset")" == 3 &&
   "$(xmllint --xpath "count(//*[@id='header-topleft' or @id='header-topright']/*[2][local-name()='path' and @fill='#a6afbd' and @fill-opacity='0.18'])" "$heading_asset")" == 2 &&
   "$(xmllint --xpath "count(//*[@id='header-bottomleft' or @id='header-bottomright']/*[@fill='#a6afbd'])" "$heading_asset")" == 4 ]] || {
  printf '%s header must preserve the popup rim and join its bottom separator at both sides.\n' "$heading_asset" >&2
  exit 1
}
[[ "$(xmllint --xpath "count(//*[@id='footer-bottom' or @id='footer-left' or @id='footer-right']/*[2][@fill='#a6afbd' and @fill-opacity='0.18'])" "$heading_asset")" == 3 &&
   "$(xmllint --xpath "count(//*[@id='footer-bottomleft' or @id='footer-bottomright']/*[2][local-name()='path' and @fill='#a6afbd' and @fill-opacity='0.18'])" "$heading_asset")" == 2 ]] || {
  printf '%s footer must preserve the popup rim across its lower corners.\n' "$heading_asset" >&2
  exit 1
}

for asset in "${surface_assets[@]}"; do
  [[ "$(xmllint --xpath "string(//*[@id='rim-topleft']/@d)" "$asset")" == 'M16 .5H15C6.99.5.5 6.99.5 15V16' &&
     "$(xmllint --xpath "string(//*[@id='rim-topright']/@d)" "$asset")" == 'M0 .5H1c8.01 0 14.5 6.49 14.5 14.5V16' &&
     "$(xmllint --xpath "string(//*[@id='rim-bottomleft']/@d)" "$asset")" == 'M16 15.5H15C6.99 15.5.5 9.01.5 1V0' &&
     "$(xmllint --xpath "string(//*[@id='rim-bottomright']/@d)" "$asset")" == 'M0 15.5H1c8.01 0 14.5-6.49 14.5-14.5V0' ]] || {
    printf '%s must carry every corner rim exactly to its adjoining slice boundary.\n' "$asset" >&2
    exit 1
  }
done

dialog_shadow_selector="//*[starts-with(@id, 'shadow-') and not(starts-with(@id, 'shadow-hint-')) and (local-name()='rect' or local-name()='path' or local-name()='g')]"
for asset in "$popup_asset" "$solid_popup_asset"; do
  dialog_shadow_count="$(xmllint --xpath "count($dialog_shadow_selector)" "$asset")"
  neutral_dialog_shadow_count="$(xmllint --xpath "count(${dialog_shadow_selector}[@fill-opacity and number(@fill-opacity) <= 0.001])" "$asset")"
  [[ "$dialog_shadow_count" == 9 && "$neutral_dialog_shadow_count" == 9 ]] || {
    printf '%s must retain nine neutral shadow-suppression slices.\n' "$asset" >&2
    exit 1
  }
done

for asset in "$panel_asset" "$solid_panel_asset"; do
  shadow_selector="//*[starts-with(@id, 'shadow-') and not(starts-with(@id, 'shadow-hint-')) and (local-name()='rect' or local-name()='path' or local-name()='g')]"
  shadow_count="$(xmllint --xpath "count($shadow_selector)" "$asset")"
  neutral_shadow_count="$(xmllint --xpath "count(${shadow_selector}[@fill-opacity and number(@fill-opacity) <= 0.001])" "$asset")"
  [[ "$shadow_count" == 9 && "$neutral_shadow_count" == 9 ]] || {
    printf '%s must keep all nine shadow slices neutral and seam-free.\n' "$asset" >&2
    exit 1
  }
  for side in top bottom; do
    [[ "$(xmllint --xpath "string(//*[@id='floating-hint-$side-margin']/@height)" "$asset")" == 12 ]] || {
      printf '%s floating %s padding must retain the complete twelve-pixel shadow.\n' "$asset" "$side" >&2
      exit 1
    }
  done
  for side in left right; do
    [[ "$(xmllint --xpath "string(//*[@id='floating-hint-$side-margin']/@width)" "$asset")" == 12 ]] || {
      printf '%s floating %s padding must retain the complete twelve-pixel shadow.\n' "$asset" "$side" >&2
      exit 1
    }
  done
done

[[ "$(xmllint --xpath "string(//*[@id='center']/@fill-opacity)" "$panel_asset")" == 0.66 ]] || {
  printf 'Proper translucent shelf must use the reviewed 0.66 tint opacity.\n' >&2
  exit 1
}
[[ "$(xmllint --xpath "string(//*[@id='center']/@fill-opacity)" "$solid_panel_asset")" == 1.00 ]] || {
  printf 'Proper dense shelf state must remain fully opaque.\n' >&2
  exit 1
}
for contrast_setting in enabled=true contrast=0.72 intensity=0.82 saturation=1.15; do
  grep -qx "$contrast_setting" "$style_root/plasmarc" || {
    printf 'Proper Plasma material is missing contrast setting %s.\n' "$contrast_setting" >&2
    exit 1
  }
done
grep -qx 'ShellPackage=com.properlinux.desktop' "$shell_defaults"
for blur_setting in BlurStrength=15 NoiseStrength=5 Saturation=150; do
  grep -qx "$blur_setting" "$kwin_defaults" || {
    printf 'Proper KWin material is missing blur setting %s.\n' "$blur_setting" >&2
    exit 1
  }
done

panel_radius="$(sed -n "s/^radius: {panel: \([0-9][0-9]*\),.*/\1/p" "$tokens")"
asset_radius="$(xmllint --xpath "string(//*[@id='top']/*[1]/@height)" \
  "$panel_asset")"
mask_radius="$(xmllint --xpath "string(//*[@id='mask-top']/@height)" \
  "$panel_asset")"
[[ -n "$panel_radius" && "$panel_radius" == "$asset_radius" && "$panel_radius" == "$mask_radius" ]] || {
  printf 'Panel radius token (%s), visible corner slice (%s), and mask slice (%s) must match.\n' \
    "$panel_radius" "$asset_radius" "$mask_radius" >&2
  exit 1
}

left_margin="$(xmllint --xpath "string(//*[@id='hint-left-margin']/@width)" "$panel_asset")"
right_margin="$(xmllint --xpath "string(//*[@id='hint-right-margin']/@width)" "$panel_asset")"
[[ "$left_margin" == "$right_margin" ]] || {
  printf 'Proper shelf end margins must be symmetric; found left %s and right %s.\n' \
    "$left_margin" "$right_margin" >&2
  exit 1
}

for state in normal focus hover minimized attention progress; do
  for slice in center top bottom left right topleft topright bottomleft bottomright; do
    count="$(xmllint --xpath "count(//*[@id='$state-$slice'])" "$task_asset")"
    [[ "$count" == 1 ]] || {
      printf 'Proper task asset must define %s-%s exactly once; found %s.\n' \
        "$state" "$slice" "$count" >&2
      exit 1
    }
  done
done
visible_task_shapes="$(xmllint --xpath "count(//*[starts-with(@id, 'normal-') or starts-with(@id, 'focus-') or starts-with(@id, 'hover-') or starts-with(@id, 'minimized-') or starts-with(@id, 'attention-') or starts-with(@id, 'progress-')]//*[self::rect or self::circle or self::path][not(@fill-opacity) or number(@fill-opacity) > 0.001])" "$task_asset")"
[[ "$visible_task_shapes" == 0 ]] || {
  printf 'Proper task FrameSvg edge slices must be visually empty; found %s visible shapes.\n' "$visible_task_shapes" >&2
  exit 1
}
nonzero_task_geometry="$(xmllint --xpath "count(//*[starts-with(@id, 'normal-') or starts-with(@id, 'focus-') or starts-with(@id, 'hover-') or starts-with(@id, 'minimized-') or starts-with(@id, 'attention-') or starts-with(@id, 'progress-')]//*[@fill-opacity and number(@fill-opacity) != 0])" "$task_asset")"
[[ "$nonzero_task_geometry" == 0 ]] || {
  printf 'Proper task geometry must be exactly transparent; found %s nonzero shapes.\n' "$nonzero_task_geometry" >&2
  exit 1
}
for direction in top bottom left right; do
  [[ "$(xmllint --xpath "count(//*[@id='group-expander-$direction'])" "$task_asset")" == 1 ]] || {
    printf 'Proper task asset must suppress the inherited %s group badge.\n' "$direction" >&2
    exit 1
  }
done
[[ "$(xmllint --xpath "count(//*[starts-with(@id, 'hover-')]//*[@class='ColorScheme-ButtonFocus' or @class='ColorScheme-ButtonHover'])" "$task_asset")" == 0 ]] || {
  printf 'Proper hover task state must not contain a filled blue focus or hover shape.\n' >&2
  exit 1
}

grep -q 'id: launchIndicator' "$task_loading_patch"
grep -q 'id: launchPath' "$task_loading_patch"
grep -q 'id: launchMotion' "$task_loading_patch"
grep -q 'duration: 700' "$task_loading_patch"
grep -q 'id: properStateIndicator' "$task_loading_patch"
grep -q 'visibleDotCount: Math.min(windowCount, 4)' "$task_loading_patch"
grep -q 'active: model.IsWindow' "$task_loading_patch"
! grep -q 'id: launchTrack' "$task_loading_patch" || {
  printf 'Proper launch feedback must not draw a visible track behind its dot.\n' >&2
  exit 1
}
! grep -q '^+.*PlasmaComponents3[.]BusyIndicator' "$task_loading_patch" || {
  printf 'Proper task startup patch must replace Plasma\x27s circular busy indicator.\n' >&2
  exit 1
}

mapfile -t plasma_spec_patches < <(
  find "$project_root/packages" -mindepth 2 -maxdepth 2 -type f -name '*.spec.patch' -print | sort
)
expected_plasma_spec_patches=(
  "$project_root/packages/plasma-desktop/plasma-desktop.spec.patch"
  "$project_root/packages/plasma-login-manager/plasma-login-manager.spec.patch"
)
[[ "${plasma_spec_patches[*]}" == "${expected_plasma_spec_patches[*]}" ]] || {
  printf 'Proper must carry exactly the two documented Plasma source-package exceptions.\n' >&2
  printf 'Found: %s\n' "${plasma_spec_patches[*]:-none}" >&2
  exit 1
}
! grep -Eq 'libplasma|plasma-workspace' "$project_root/scripts/build-rpms" || {
  printf 'Unpatched libplasma and plasma-workspace must remain on Fedora\x27s update path.\n' >&2
  exit 1
}

tooltip_delay="$(awk '
  /^\[PlasmaToolTips\]$/ { in_group = 1; next }
  /^\[/ { in_group = 0 }
  in_group && /^Delay=/ { sub(/^Delay=/, ""); print; exit }
' "$plasma_defaults")"
[[ "$tooltip_delay" == 900 ]] || {
  printf 'Proper shell hover tooltips must use the reviewed 900ms delay; found %s.\n' \
    "${tooltip_delay:-unset}" >&2
  exit 1
}
grep -Fq 'tasks.writeConfig("showToolTips", true)' "$desktop_layout"
grep -q 'current_delay.*== 0' "$project_root/packages/proper-defaults/proper-tooltip-default-repair"
grep -q 'key Delay 900' "$project_root/packages/proper-defaults/proper-tooltip-default-repair"
grep -qx 'Id=proper-tooltip-delay-v2' "$tooltip_update"
grep -qx 'Script=proper-tooltip-default-repair,sh' "$tooltip_update"
grep -q '%{_datadir}/kconf_update/proper-defaults.upd' "$defaults_spec"
grep -q '%{_prefix}/lib/plasmalogin/plasmalogin.conf.d/50-proper.conf' "$spec"
! grep -q '/lib/plasmalogin/defaults.conf' "$spec" || {
  printf 'Proper must not overwrite the Plasma Login Manager defaults owned by Fedora.\n' >&2
  exit 1
}
grep -qx 'config_dir=/etc/plasmalogin.conf.d' \
  "$project_root/packages/proper-appearance/proper-set-login-wallpaper"
grep -Fq 'clock.currentConfigGroup = ["Appearance"]' "$desktop_layout"
grep -Fq 'clock.writeConfig("dateFormat", "custom")' "$desktop_layout"
grep -Fq 'clock.writeConfig("customDateFormat", "MMMM d")' "$desktop_layout"
grep -Fq 'const legacyFormat = clock.readConfig("Appearance.dateFormat", "")' "$panel_migration"
grep -Fq 'const currentFormat = clock.readConfig("dateFormat", "")' "$panel_migration"
grep -Fq 'panel.minimumLength === 320' "$panel_migration"
grep -Fq 'panel.minimumLength = 560' "$panel_migration"
grep -Fq 'spacer.writeConfig("length", 86)' "$panel_migration"
grep -Fq 'panel.widgets("com.properlinux.statusshade")' "$status_migration"
grep -Fq 'panel.hiding === "autohide"' "$status_migration"
grep -Fq 'panel.lengthMode = "custom"' "$status_migration"
grep -Fq 'panel.length = 112' "$status_migration"
grep -Fq 'panel.hiding = "none"' "$status_migration"
! grep -q 'plasma-org.kde.plasma.desktop-appletsrc' "$defaults_spec"

dark_window_rgb="$(awk '
  /^\[Colors:Window\]$/ { in_window = 1; next }
  /^\[/ { in_window = 0 }
  in_window && /^BackgroundNormal=/ { sub(/^BackgroundNormal=/, ""); print; exit }
' "$dark_scheme")"
IFS=, read -r dark_red dark_green dark_blue <<<"$dark_window_rgb"
[[ "$dark_red" =~ ^[0-9]+$ && "$dark_green" =~ ^[0-9]+$ && "$dark_blue" =~ ^[0-9]+$ ]] &&
  (( dark_red < 80 && dark_green < 80 && dark_blue < 80 )) || {
    printf 'Proper Dark window background must be dark; found %s.\n' "${dark_window_rgb:-missing}" >&2
    exit 1
  }

default_view_rgb="$(awk '
  /^\[Colors:View\]$/ { in_view = 1; next }
  /^\[/ { in_view = 0 }
  in_view && /^BackgroundNormal=/ { sub(/^BackgroundNormal=/, ""); print; exit }
' "$dark_scheme")"
[[ "$default_view_rgb" == "21,26,34" ]] || {
  printf 'Generated Proper Dark scheme must materialize the dark view palette; found %s.\n' \
    "${default_view_rgb:-missing}" >&2
  exit 1
}

! grep -q '^\[Colors:' "$default_kdeglobals" || {
  printf 'KDE XDG defaults must select a scheme rather than duplicate its colour groups.\n' >&2
  exit 1
}
grep -qx 'ColorScheme=Proper' "$default_kdeglobals"
grep -qx 'Theme=proper-dark' "$default_kdeglobals"
grep -qx 'Inherits=breeze' "$light_icon_index"
grep -qx 'Inherits=breeze-dark' "$dark_icon_index"
grep -qx 'Theme=proper-dark' "$dark_look_defaults"
grep -qx 'Theme=proper' "$light_look_defaults"
grep -qx 'Theme=proper-dark' "$midnight_look_defaults"
grep -Fq '../../../breeze/places/$size/folder-blue.svg' "$spec"
grep -Fq '../../../breeze-dark/places/$size/folder-blue.svg' "$spec"
grep -Fq 'org.kde.dolphin.svg' "$spec"

printf 'Plasma UX valid: generated adaptive shelf material, bounded controls, exact task indicators, delayed previews/tooltips, and matched masks.\n'
