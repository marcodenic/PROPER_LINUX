#!/usr/bin/env bash
# Reject malformed Plasma SVG assets and rectangular shell-surface regressions.
# The compose hint makes Plasma clip contrast/blur to the rounded mask; neutral
# shadow slices suppress Plasma's visible Breeze fallback.
set -Eeuo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
style_root="$project_root/packages/proper-look-and-feel/proper"
metadata="$style_root/metadata.json"
spec="$project_root/packages/proper-look-and-feel/proper-look-and-feel.spec"
tokens="$project_root/packages/proper-look-and-feel/tokens.yaml"
plasma_defaults="$project_root/packages/proper-defaults/plasmarc"

command -v xmllint >/dev/null 2>&1 || {
  printf 'Required command missing: xmllint\n' >&2
  exit 1
}

while IFS= read -r -d '' asset; do
  xmllint --noout "$asset"
done < <(find "$style_root" -type f -name '*.svg' -print0)

shadow_assets=(
  "$style_root/widgets/panel-background.svg"
  "$style_root/dialogs/background.svg"
)

package_version="$(awk '$1 == "Version:" { print $2; exit }' "$spec")"
package_release="$(awk '$1 == "Release:" { print $2; exit }' "$spec")"
package_release="${package_release%%%*}"
style_version="$(sed -n 's/^[[:space:]]*"Version": "\([^"]*\)",$/\1/p' "$metadata")"
expected_style_version="$package_version.$package_release"
[[ "$style_version" == "$expected_style_version" ]] || {
  printf 'Plasma Style metadata version is %s; expected %s from the RPM version and release.\n' \
    "$style_version" "$expected_style_version" >&2
  printf 'Bump the style version with the RPM release so Plasma cannot reuse stale SVG caches.\n' >&2
  exit 1
}

required_ids=(
  center top bottom left right
  topleft topright bottomleft bottomright
  mask-center mask-top mask-bottom mask-left mask-right
  mask-topleft mask-topright mask-bottomleft mask-bottomright
)

for asset in "${shadow_assets[@]}"; do
  for required_id in "${required_ids[@]}"; do
    count="$(xmllint --xpath "count(//*[@id='$required_id'])" "$asset")"
    [[ "$count" == 1 ]] || {
      printf '%s must define id=%s exactly once; found %s.\n' \
        "$asset" "$required_id" "$count" >&2
      exit 1
    }
  done
  shadow_selector="//*[starts-with(@id, 'shadow-') and not(starts-with(@id, 'shadow-hint-'))]"
  shadow_count="$(xmllint --xpath "count($shadow_selector)" "$asset")"
  neutral_shadow_count="$(xmllint --xpath "count(${shadow_selector}[@fill-opacity and number(@fill-opacity) <= 0.001])" "$asset")"
  [[ "$shadow_count" == 9 && "$neutral_shadow_count" == 9 ]] || {
    printf '%s must define nine neutral shadow-suppression slices; found %s total and %s neutral.\n' \
      "$asset" "$shadow_count" "$neutral_shadow_count" >&2
    printf 'Visible shell shadows are forbidden until their rounded alpha masks have render regression tests.\n' >&2
    exit 1
  }
  compose_hint_count="$(xmllint --xpath "count(//*[@id = 'hint-compose-over-border'])" "$asset")"
  [[ "$compose_hint_count" == 1 ]] || {
    printf '%s must define hint-compose-over-border exactly once; found %s.\n' \
      "$asset" "$compose_hint_count" >&2
    printf 'Without it Plasma can expose square contrast and blur regions behind rounded corners.\n' >&2
    exit 1
  }
done

panel_radius="$(sed -n "s/^radius: {panel: \([0-9][0-9]*\),.*/\1/p" "$tokens")"
asset_radius="$(xmllint --xpath "string(//*[@id='top']/*[1]/@height)" \
  "$style_root/widgets/panel-background.svg")"
mask_radius="$(xmllint --xpath "string(//*[@id='mask-top']/@height)" \
  "$style_root/widgets/panel-background.svg")"
[[ -n "$panel_radius" && "$panel_radius" == "$asset_radius" && "$panel_radius" == "$mask_radius" ]] || {
  printf 'Panel radius token (%s), visible corner slice (%s), and mask slice (%s) must match.\n' \
    "$panel_radius" "$asset_radius" "$mask_radius" >&2
  exit 1
}

tooltip_delay="$(awk '
  /^\[PlasmaToolTips\]$/ { in_group = 1; next }
  /^\[/ { in_group = 0 }
  in_group && /^Delay=/ { sub(/^Delay=/, ""); print; exit }
' "$plasma_defaults")"
[[ "$tooltip_delay" == 0 ]] || {
  printf 'Proper shell hover tooltips must default to Delay=0; found %s.\n' \
    "${tooltip_delay:-unset}" >&2
  exit 1
}

printf 'Plasma theme valid: matched panel radius/mask, neutral shadows, and hover tooltips disabled.\n'
