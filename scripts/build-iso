#!/usr/bin/env bash
# Build the pinned Fedora KDE 44 live ISO with Proper's reviewed overlay.
set -Eeuo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$project_root/image/upstream/fedora-kde-44.lock"
output_root="${PROPER_OUTPUT_DIR:-"$project_root/../proper-linux-build"}"
cache_root="${PROPER_CACHE_DIR:-"$output_root/cache"}"
source_dir="$cache_root/$UPSTREAM_NAME"
if [[ "${PROPER_BASELINE:-0}" == 1 ]]; then
  iso_dir="$output_root/iso/fedora-kde-44-$UPSTREAM_COMMIT"
else
  iso_dir="$output_root/iso/proper-linux-0.1-${UPSTREAM_COMMIT:0:12}"
fi
build_source_dir="$iso_dir/source"

require_manifest_package_from_spec() {
  local manifest="$1" package="$2" source_file="$3" description="$4"
  local version release
  version="$(awk '$1 == "Version:" || $1 == "+Version:" { print $2; exit }' "$source_file")"
  release="$(awk '$1 == "Release:" || $1 == "+Release:" { print $2; exit }' "$source_file")"
  release="$(sed 's/%{?dist}/.fc44/g' <<<"$release")"
  [[ -n "$version" && -n "$release" ]] || {
    printf 'Cannot derive the expected package version from %s.\n' "$source_file" >&2
    exit 1
  }
  grep -Fq "${package}|(none)|${version}|${release}|" "$manifest" || {
    printf 'Built image does not contain %s (%s-%s).\n' "$description" "$version" "$release" >&2
    exit 1
  }
}

for binary in fc-scan git lsinitrd patch sha256sum stat strings xmllint xorriso; do
  command -v "$binary" >/dev/null 2>&1 || { printf 'Required command missing: %s\n' "$binary" >&2; exit 1; }
done
[[ -n "$UPSTREAM_COMMIT" ]] || { printf 'Fedora input is not pinned. Run scripts/pin-fedora-base, review the lock, then rerun.\n' >&2; exit 1; }
[[ "$UPSTREAM_COMMIT" =~ ^[0-9a-f]{40}$ ]] || { printf 'Invalid UPSTREAM_COMMIT in image/upstream/fedora-kde-44.lock\n' >&2; exit 1; }

if [[ "${PROPER_VALIDATE_EXISTING:-0}" != 1 ]]; then
mkdir -p "$cache_root" "$iso_dir"
if [[ ! -d "$source_dir/.git" ]]; then
  git clone "$UPSTREAM_URL" "$source_dir"
fi
git -C "$source_dir" fetch --quiet origin "$UPSTREAM_COMMIT"
git -C "$source_dir" checkout --detach --quiet "$UPSTREAM_COMMIT"

rm -rf "$build_source_dir"
mkdir -p "$build_source_dir"
  cp -a "$source_dir/." "$build_source_dir/"
  # Fedora's KDE profile explicitly pulls the LibreOffice collection. Proper
  # keeps the base image lean and offers office software through the future
  # catalogue, so apply this narrow profile-local exclusion to the pinned
  # upstream description during composition.
  sed -i '/<namedCollection name="libreoffice"\/>/d; /<package name="libreoffice-/d; /<package name="plasma-welcome-fedora"\/>/d' \
    "$build_source_dir/components/desktops/kde.xml"
  sed -i '/<package name="mediawriter"\/>/d' \
    "$build_source_dir/components/desktops/common.xml"
  sed -i '/<package name="plasma-welcome-fedora"\/>/d' \
    "$build_source_dir/teams/kde.xml"
if [[ "${PROPER_BASELINE:-0}" == 1 ]]; then
  kiwi_file=/source/Fedora.kiwi
else
  # An ordinary product build remains clean and conservative. During a
  # reviewed image-only iteration, callers may explicitly reuse the RPM repo
  # produced by the immediately preceding successful build; the final image
  # validators below still enforce every expected package NEVRA.
  if [[ "${PROPER_REUSE_RPMS:-0}" == 1 ]]; then
    [[ -f "$output_root/repo/repodata/repomd.xml" ]] || {
      printf 'PROPER_REUSE_RPMS=1 requested, but no complete RPM repository exists: %s\n' "$output_root/repo" >&2
      exit 1
    }
    printf 'Reusing reviewed RPM repository for image-only iteration: %s\n' "$output_root/repo"
  else
    PROPER_OUTPUT_DIR="$output_root" "$project_root/scripts/build-rpms"
  fi
  cp -a "$project_root/image/descriptions/proper.xml" "$build_source_dir/proper.xml"
  patch --batch --forward -d "$build_source_dir" -p1 < "$project_root/image/descriptions/proper-media.patch"
  # Fedora's upstream hook ends with `exit 0`.  Insert our live-session hook
  # before that terminator so KIWI actually executes it while composing the
  # image rather than leaving it as unreachable text.
  sed -i '${/^exit 0$/d;}' "$build_source_dir/config.sh"
  cat "$project_root/image/descriptions/proper-live-config.sh" >> "$build_source_dir/config.sh"
  printf '\nexit 0\n' >> "$build_source_dir/config.sh"
  cp -a "$output_root/repo" "$build_source_dir/repo"
  # Fedora's label generator parses Fedora.kiwi directly, so preserve it as
  # the top-level document and append only the Proper overlay.
  sed -i 's#</image>#\t<include from="this://./proper.xml"/>\n</image>#' "$build_source_dir/Fedora.kiwi"
  kiwi_file=/source/Fedora.kiwi
fi

# KIWI refuses to reuse an incomplete root from a failed build. This directory
# is generated beneath the selected ISO output and contains no source files.
# A rootless container owns some image-root files in its user namespace.
if [[ -d "$iso_dir/image-build" ]]; then
  if [[ "$(id -u)" -eq 0 ]]; then
    rm -rf "$iso_dir/image-build"
  elif command -v podman >/dev/null 2>&1; then
    podman unshare rm -rf "$iso_dir/image-build"
  else
    printf 'Cannot remove generated KIWI state without root or Podman: %s\n' "$iso_dir/image-build" >&2
    exit 1
  fi
fi

using_container=0
if command -v kiwi-ng >/dev/null 2>&1 && [[ "$(id -u)" -eq 0 ]]; then
  runner=()
elif command -v kiwi-ng >/dev/null 2>&1 && command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then
  runner=(sudo)
elif command -v podman >/dev/null 2>&1; then
  using_container=1
  builder_image="localhost/proper-linux-kiwi-builder:fedora44"
  mkdir -p "$iso_dir/tmp"
  podman build --tag "$builder_image" --file "$project_root/image/Containerfile" "$project_root/image"
  podman run --rm --privileged --volume "$build_source_dir:/source:Z" --volume "$iso_dir:/output:Z" --volume "$iso_dir/tmp:/var/tmp:Z" "$builder_image" /source/kiwi-build --kiwi-file="$kiwi_file" --image-type="$IMAGE_TYPE" --image-profile="$IMAGE_PROFILE" --output-dir=/output/image 2>&1 | tee "$iso_dir/kiwi-build.log"
  runner=()
else
  printf 'KIWI requires root/sudo or a functional Podman runtime.\n' >&2
  exit 1
fi

if (( using_container == 0 )); then
  local_kiwi_file="${kiwi_file#/source}"
  "${runner[@]}" "$build_source_dir/kiwi-build" --kiwi-file="$build_source_dir$local_kiwi_file" --image-type="$IMAGE_TYPE" --image-profile="$IMAGE_PROFILE" --output-dir="$iso_dir"
fi
else
  printf 'Validating existing release image without recomposing it: %s\n' "$iso_dir"
fi

mapfile -t images < <(find "$iso_dir" -maxdepth 3 -type f -name '*.iso' -print)
(( ${#images[@]} == 1 )) || { printf 'Expected exactly one ISO in %s; found %d.\n' "$iso_dir" "${#images[@]}" >&2; exit 1; }
if [[ "${PROPER_BASELINE:-0}" != 1 ]]; then
  iso_size_bytes="$(stat -c '%s' "${images[0]}")"
  if (( iso_size_bytes >= 3 * 1024 * 1024 * 1024 )); then
    printf 'Proper image is %d bytes; Start Here promises a complete image below 3 GiB.\n' "$iso_size_bytes" >&2
    exit 1
  fi
  printf 'Verified lean-image claim: %d bytes (below 3 GiB).\n' "$iso_size_bytes"
  mapfile -t package_manifests < <(find "$iso_dir" -maxdepth 3 -type f -name '*.packages' -print)
  (( ${#package_manifests[@]} == 1 )) || {
    printf 'Expected exactly one package manifest in %s; found %d.\n' "$iso_dir" "${#package_manifests[@]}" >&2
    exit 1
  }
  if grep -Eq '^initial-setup(\||-)' "${package_manifests[0]}"; then
    printf 'Legacy initial-setup packages entered the Proper image; Fedora KDE must use plasma-setup.\n' >&2
    exit 1
  fi
  grep -Eq '^plasma-setup\|' "${package_manifests[0]}" || {
    printf 'Fedora plasma-setup is missing from the Proper image package manifest.\n' >&2
    exit 1
  }
  for package in proper-release proper-branding proper-welcome; do
    grep -Eq "^${package}\\|" "${package_manifests[0]}" || {
      printf 'Required arrival package is missing from the Proper image: %s\n' "$package" >&2
      exit 1
    }
  done
  require_manifest_package_from_spec "${package_manifests[0]}" proper-look-and-feel \
    "$project_root/packages/proper-look-and-feel/proper-look-and-feel.spec" \
    'the current Proper Plasma Style'
  for upstream_applet in plasma-nm bluedevil plasma-pa kscreen; do
    upstream_epoch='\(none\)'
    [[ "$upstream_applet" == kscreen ]] && upstream_epoch='1'
    grep -Eq "^${upstream_applet}\\|${upstream_epoch}\\|6[.]7[.]4\\|1[.]fc44\\|" "${package_manifests[0]}" || {
      printf 'Built image does not retain the reviewed Fedora %s package unchanged.\n' "$upstream_applet" >&2
      exit 1
    }
  done
  grep -Eq '^powerdevil\|\(none\)\|6[.]7[.]4\|2[.]fc44\|' "${package_manifests[0]}" || {
    printf 'Built image does not retain the reviewed Fedora powerdevil Qt 6 rebuild unchanged.\n' >&2
    exit 1
  }
  require_manifest_package_from_spec "${package_manifests[0]}" proper-agent-status \
    "$project_root/packages/proper-agent-status/proper-agent-status.spec" 'the current status integration'
  require_manifest_package_from_spec "${package_manifests[0]}" proper-defaults \
    "$project_root/packages/proper-defaults/proper-defaults.spec" 'the current desktop defaults'
  require_manifest_package_from_spec "${package_manifests[0]}" plasma-desktop \
    "$project_root/packages/plasma-desktop/plasma-desktop.spec.patch" 'the pinned task-state patch'
  require_manifest_package_from_spec "${package_manifests[0]}" plasma-workspace \
    "$project_root/packages/plasma-workspace/plasma-workspace.spec.patch" 'the pinned tray-tooltip presentation patch'
  require_manifest_package_from_spec "${package_manifests[0]}" plasma-login-manager \
    "$project_root/packages/plasma-login-manager/plasma-login-manager.spec.patch" 'the pinned login composition'
  for proper_package in proper-release proper-branding proper-terminal proper-welcome proper-apps proper-appearance proper-launchers; do
    require_manifest_package_from_spec "${package_manifests[0]}" "$proper_package" \
      "$project_root/packages/$proper_package/$proper_package.spec" "the current $proper_package release"
  done
  grep -Eq '^rsms-inter-fonts\|\(none\)\|4[.]1\|3[.]fc44\|' "${package_manifests[0]}" || {
    printf 'Fedora Inter 4.1 package is missing or changed without review.\n' >&2
    exit 1
  }
  grep -Eq '^google-noto-sans-fonts\|' "${package_manifests[0]}" || {
    printf 'Noto Sans fallback package is missing from the Proper image.\n' >&2
    exit 1
  }
  grep -Eq '^jetbrains-mono-fonts\|' "${package_manifests[0]}" || {
    printf 'JetBrains Mono terminal font package is missing from the Proper image.\n' >&2
    exit 1
  }
  for integration_package in \
    breeze-gtk-gtk3 breeze-gtk-gtk4 flatpak flatpak-kcm \
    xdg-desktop-portal xdg-desktop-portal-gtk xdg-desktop-portal-kde; do
    grep -Eq "^${integration_package}\\|" "${package_manifests[0]}" || {
      printf 'Cross-toolkit or sandbox integration is missing from the image: %s\n' \
        "$integration_package" >&2
      exit 1
    }
  done
  if grep -Eq '^fedora-release-identity-kde-desktop\|' "${package_manifests[0]}"; then
    printf 'Fedora KDE edition identity remained installed beside proper-release.\n' >&2
    exit 1
  fi
  grep -Eq '^generic-logos\|' "${package_manifests[0]}" || {
    printf 'Generic system-logo compatibility package is missing from the Proper image.\n' >&2
    exit 1
  }
  if grep -Eq '^fedora-logos\|' "${package_manifests[0]}"; then
    printf 'Fedora official logo package remained in the Proper image.\n' >&2
    exit 1
  fi
  image_os_release="$iso_dir/image-build/build/image-root/usr/lib/os-release"
  [[ -f "$image_os_release" ]] && grep -qx 'ID=proper' "$image_os_release" || {
    printf 'Built image does not identify itself as Proper Linux: %s\n' "$image_os_release" >&2
    exit 1
  }
  image_plymouth_config="$iso_dir/image-build/build/image-root/etc/plymouth/plymouthd.conf"
  [[ -f "$image_plymouth_config" ]] && grep -qx 'Theme=proper' "$image_plymouth_config" || {
    printf 'Built image does not select the Proper Plymouth theme: %s\n' "$image_plymouth_config" >&2
    exit 1
  }
  image_dark_scheme="$iso_dir/image-build/build/image-root/usr/share/color-schemes/Proper.colors"
  image_kdeglobals="$iso_dir/image-build/build/image-root/etc/xdg/kdeglobals"
  image_root="$iso_dir/image-build/build/image-root"
  image_vicinae_settings="$image_root/etc/skel/.config/vicinae/settings.json"
  image_vicinae_theme="$image_root/usr/share/vicinae/themes/proper-dark.toml"
  [[ -f "$image_vicinae_settings" && -f "$image_vicinae_theme" ]] &&
    grep -Fq '"dark": { "name": "proper-dark"' "$image_vicinae_settings" &&
    grep -Fq '"opacity": 0.66' "$image_vicinae_settings" &&
    grep -Fq '"rounding": 16' "$image_vicinae_settings" &&
    grep -Fq 'background = "#141a22"' "$image_vicinae_theme" || {
      printf 'Built image does not give Vicinae the Proper shelf material.\n' >&2
      exit 1
    }
  grep -A12 '^\[Colors:Header\]$' "$image_dark_scheme" | grep -Fq 'BackgroundNormal=20,26,34' || {
    printf 'Built image window title bars do not use the Proper shelf tint.\n' >&2
    exit 1
  }
  light_files_icon="$image_root/usr/share/icons/proper/apps/64/org.kde.dolphin.svg"
  dark_files_icon="$image_root/usr/share/icons/proper-dark/apps/64/org.kde.dolphin.svg"
  [[ -f "$image_root/usr/share/icons/proper/index.theme" &&
     -f "$image_root/usr/share/icons/proper-dark/index.theme" &&
     -L "$light_files_icon" &&
     -L "$dark_files_icon" &&
     "$(readlink "$light_files_icon")" == '../../../breeze/places/64/folder-blue.svg' &&
     "$(readlink "$dark_files_icon")" == '../../../breeze-dark/places/64/folder-blue.svg' ]] || {
    printf 'Built image does not map Dolphin to the selected Breeze folder icon.\n' >&2
    exit 1
  }
  grep -qx 'Theme=proper-dark' "$image_kdeglobals" || {
    printf 'Built image does not select the Proper dark icon layer for new profiles.\n' >&2
    exit 1
  }
  [[ -x "$image_root/usr/bin/proper-agent-status" &&
     -f "$image_root/usr/share/plasma/plasmoids/com.properlinux.agentstatus/metadata.json" &&
     -f "$image_root/usr/share/plasma/plasmoids/com.properlinux.agentstatus/contents/ui/main.qml" &&
     -f "$image_root/usr/share/plasma/plasmoids/com.properlinux.statusshade/metadata.json" &&
     -f "$image_root/usr/share/plasma/plasmoids/com.properlinux.statusshade/contents/ui/FullRepresentation.qml" &&
     -f "$image_root/usr/lib/systemd/user/proper-agent-panel.timer" &&
     -x "$image_root/usr/bin/proper-qemu-review-display" &&
     -f "$image_root/usr/lib/systemd/system/plasmalogin.service.d/20-proper-review-display.conf" ]] || {
    printf 'Built image is missing the status shade, agent helper, or Plasma widgets.\n' >&2
    exit 1
  }
  [[ ! -e "$image_root/etc/xdg/plasma-org.kde.plasma.desktop-appletsrc" ]] || {
    printf 'Built image still carries a duplicate static Plasma panel configuration.\n' >&2
    exit 1
  }
  [[ "$(readlink "$image_root/etc/localtime")" == "../usr/share/zoneinfo/Europe/London" ]] || {
    printf 'Built image does not use the reviewed Europe/London v0.1 time-zone default.\n' >&2
    exit 1
  }
  dark_window_rgb="$(awk '
    /^\[Colors:Window\]$/ { in_window = 1; next }
    /^\[/ { in_window = 0 }
    in_window && /^BackgroundNormal=/ { sub(/^BackgroundNormal=/, ""); print; exit }
  ' "$image_dark_scheme")"
  IFS=, read -r dark_red dark_green dark_blue <<<"$dark_window_rgb"
  [[ "$dark_red" =~ ^[0-9]+$ && "$dark_green" =~ ^[0-9]+$ && "$dark_blue" =~ ^[0-9]+$ ]] &&
    (( dark_red < 80 && dark_green < 80 && dark_blue < 80 )) || {
      printf 'Proper Dark image palette is not dark: %s\n' "${dark_window_rgb:-missing}" >&2
      exit 1
    }
  ! grep -q '^\[Colors:' "$image_kdeglobals" || {
    printf 'Built image duplicates colour groups instead of selecting the generated scheme.\n' >&2
    exit 1
  }
  for scheme in Proper ProperLight ProperMidnight; do
    [[ -f "$image_root/usr/share/color-schemes/$scheme.colors" ]] || {
      printf 'Built image is missing generated KDE colour scheme: %s\n' "$scheme" >&2
      exit 1
    }
  done
  [[ -f "$image_root/usr/share/proper-linux/ui/proper-palette.json" ]] || {
    printf 'Built image is missing the cross-surface semantic palette.\n' >&2
    exit 1
  }
  for font_default in \
    'desktopFont=Inter,10,-1,5,50,0,0,0,0,0' \
    'font=Inter,10,-1,5,50,0,0,0,0,0' \
    'menuFont=Inter,10,-1,5,50,0,0,0,0,0' \
    'smallestReadableFont=Inter,8,-1,5,50,0,0,0,0,0' \
    'toolBarFont=Inter,9,-1,5,50,0,0,0,0,0' \
    'activeFont=Inter,9,-1,5,50,0,0,0,0,0'; do
    grep -Fqx "$font_default" "$image_kdeglobals" || {
      printf 'Built image is missing an Inter KDE default: %s\n' "$font_default" >&2
      exit 1
    }
  done
  grep -Fqx 'fixed=JetBrains Mono,10,-1,5,50,0,0,0,0,0' "$image_kdeglobals" || {
    printf 'Built image does not retain JetBrains Mono for fixed-width KDE text.\n' >&2
    exit 1
  }
  for gtk_version in 3.0 4.0; do
    grep -Fqx 'gtk-font-name=Inter 10' "$image_root/etc/gtk-$gtk_version/settings.ini" || {
      printf 'Built image GTK %s default is not Inter.\n' "$gtk_version" >&2
      exit 1
    }
  done
  image_inter_font="$image_root/usr/share/fonts/rsms-inter-fonts/Inter-Regular.ttf"
  [[ -f "$image_inter_font" ]] || {
    printf 'Built image is missing Inter-Regular.ttf.\n' >&2
    exit 1
  }
  [[ "$(fc-scan --format '%{family[0]}|%{fontversion}\n' "$image_inter_font")" == 'Inter|262210' ]] || {
    printf 'Built Inter font family or OpenType version differs from the reviewed Inter 4 payload.\n' >&2
    exit 1
  }
  find "$image_root/usr/share/fonts" -type f -name 'NotoSans-Regular.ttf' -print -quit | grep -q . || {
    printf 'Built image has no Noto Sans regular fallback file.\n' >&2
    exit 1
  }
  image_jetbrains_font="$image_root/usr/share/fonts/jetbrains-mono-fonts/JetBrainsMono-Regular.otf"
  [[ -f "$image_jetbrains_font" ]] || {
    printf 'Built image has no Fedora JetBrains Mono regular OTF.\n' >&2
    exit 1
  }
  [[ "$(fc-scan --format '%{family[0]}|%{style[0]}|%{fontversion}\n' "$image_jetbrains_font")" == 'JetBrains Mono|Regular|150995' ]] || {
    printf 'Built JetBrains Mono family, style, or OpenType version differs from the reviewed Fedora payload.\n' >&2
    exit 1
  }
  image_widgets="$image_root/usr/share/proper-linux/ui/proper-widgets-dark.qss"
  image_web="$image_root/usr/share/proper-linux/ui/proper-web.css"
  grep -Fq 'font-family: "Inter";' "$image_widgets" || {
    printf 'Built first-party Qt UI assets do not select Inter.\n' >&2
    exit 1
  }
  grep -Fq 'font-family: Inter, "Noto Sans", sans-serif;' "$image_web" || {
    printf 'Built shortcut-reference CSS does not use the Inter/Noto fallback chain.\n' >&2
    exit 1
  }
  image_lock_qml="$image_root/usr/share/plasma/shells/com.properlinux.desktop/contents/lockscreen/LockScreenUi.qml"
  image_lock_grid="$image_root/usr/share/plasma/shells/com.properlinux.desktop/contents/lockscreen/ProperGridClock.qml"
  image_lock_password="$image_root/usr/share/plasma/shells/com.properlinux.desktop/contents/lockscreen/ProperPasswordCells.qml"
  image_lock_tokens="$image_root/usr/share/plasma/shells/com.properlinux.desktop/contents/lockscreen/ProperTokens.qml"
  [[ -f "$image_lock_tokens" ]] &&
    grep -Fq 'readonly property string uiFontFamily: properTokens.uiFont' "$image_lock_qml" || {
    printf 'Built lock screen does not consume the generated semantic tokens.\n' >&2
    exit 1
  }
  image_login_strings="$(strings -el "$image_root/usr/libexec/plasma-login-greeter")"
  grep -Fxq 'uiFontFamily' <<<"$image_login_strings" &&
    grep -Fxq 'uiFont' <<<"$image_login_strings" &&
    grep -Fxq 'Inter' <<<"$image_login_strings" || {
      printf 'Built login greeter does not embed the generated semantic token component.\n' >&2
      exit 1
    }
  [[ -f "$image_lock_grid" && -f "$image_lock_password" ]] &&
    grep -Fq 'readonly property int rowCount: 7' "$image_lock_grid" &&
    grep -Fq 'readonly property int digitColumnCount: 5' "$image_lock_grid" &&
    grep -Fq 'passwordCharacter: "▪"' "$image_lock_qml" || {
      printf 'Built lock screen lacks the Proper square-cell clock or password masks.\n' >&2
      exit 1
    }
  grep -Fxq 'glyphPattern' <<<"$image_login_strings" &&
    grep -Fxq 'visibleCellCount' <<<"$image_login_strings" || {
      printf 'Built login greeter lacks the embedded Proper square-cell components.\n' >&2
      exit 1
    }
  image_task_strings="$(strings -el \
    "$iso_dir/image-build/build/image-root/usr/lib64/qt6/plugins/plasma/applets/org.kde.plasma.taskmanager.so")"
  grep -Fxq 'launchIndicator' <<<"$image_task_strings" || {
      printf 'Built task manager plugin lacks the Proper moving-dot launch state.\n' >&2
      exit 1
    }
  grep -Fxq 'properStateIndicator' <<<"$image_task_strings" &&
    grep -Fxq 'visibleDotCount' <<<"$image_task_strings" || {
      printf 'Built task manager plugin lacks the bounded line and window-count dot states.\n' >&2
      exit 1
    }
  image_ghostty_config="$iso_dir/image-build/build/image-root/etc/skel/.config/ghostty/config"
  [[ ! -e "$image_root/etc/xdg/ghostty/config" ]] || {
    printf 'Built image still carries the unused duplicate Ghostty XDG config.\n' >&2
    exit 1
  }
  grep -Fqx 'font-family = JetBrains Mono' "$image_ghostty_config" || {
    printf 'Built Ghostty configuration no longer selects JetBrains Mono.\n' >&2
    exit 1
  }
  grep -qx 'background-opacity = 0.50' "$image_ghostty_config" || {
    printf 'Built image does not contain the approved clear Ghostty translucency.\n' >&2
    exit 1
  }
  grep -qx 'background-blur = true' "$image_ghostty_config" || {
    printf 'Built image does not enable the approved Ghostty background blur.\n' >&2
    exit 1
  }
  grep -qx 'window-padding-x = 0' "$image_ghostty_config" &&
    grep -qx 'window-padding-y = 0' "$image_ghostty_config" &&
    grep -qx 'window-padding-balance = false' "$image_ghostty_config" || {
      printf 'Built image still leaves a visible inset around the terminal grid.\n' >&2
      exit 1
    }
  [[ -x "$image_root/usr/bin/proper-terminal-inset-repair" &&
     -f "$image_root/etc/xdg/autostart/proper-terminal-inset-repair.desktop" ]] || {
    printf 'Built image cannot repair the former terminal inset for existing users.\n' >&2
    exit 1
  }
  [[ -x "$iso_dir/image-build/build/image-root/usr/bin/proper-welcome-launch" ]] || {
    printf 'Built image is missing the live welcome display launcher.\n' >&2
    exit 1
  }
  image_task_asset="$iso_dir/image-build/build/image-root/usr/share/plasma/desktoptheme/proper/widgets/tasks.svg"
  [[ -f "$image_task_asset" ]] &&
    [[ "$(xmllint --xpath "count(//*[starts-with(@id, 'normal-') or starts-with(@id, 'focus-') or starts-with(@id, 'hover-') or starts-with(@id, 'minimized-') or starts-with(@id, 'attention-') or starts-with(@id, 'progress-')]//*[local-name()='rect' or local-name()='circle' or local-name()='path'][not(@fill-opacity) or number(@fill-opacity) > 0.001])" "$image_task_asset")" == 0 ]] &&
    [[ "$(xmllint --xpath "count(//*[@id = 'group-expander-top' or @id = 'group-expander-bottom' or @id = 'group-expander-left' or @id = 'group-expander-right'])" "$image_task_asset")" == 4 ]] || {
      printf 'Built image task frames could repeat state marks or inherit a group badge.\n' >&2
      exit 1
    }
  image_panel_asset="$image_root/usr/share/plasma/desktoptheme/proper/widgets/panel-background.svg"
  image_solid_panel_asset="$image_root/usr/share/plasma/desktoptheme/proper/solid/widgets/panel-background.svg"
  image_popup_assets=(
    "$image_root/usr/share/plasma/desktoptheme/proper/dialogs/background.svg"
    "$image_root/usr/share/plasma/desktoptheme/proper/widgets/tooltip.svg"
    "$image_root/usr/share/plasma/desktoptheme/proper/widgets/translucentbackground.svg"
    "$image_root/usr/share/plasma/desktoptheme/proper/solid/dialogs/background.svg"
    "$image_root/usr/share/plasma/desktoptheme/proper/solid/widgets/tooltip.svg"
    "$image_root/usr/share/plasma/desktoptheme/proper/solid/widgets/translucentbackground.svg"
  )
  image_theme_material="$image_root/usr/share/plasma/desktoptheme/proper/plasmarc"
  for panel_material in "$image_panel_asset" "$image_solid_panel_asset"; do
    [[ -f "$panel_material" ]] && xmllint --noout "$panel_material" || {
      printf 'Built image is missing a valid Proper adaptive shelf material: %s\n' "$panel_material" >&2
      exit 1
    }
    panel_shadow_selector="//*[starts-with(@id, 'shadow-') and not(starts-with(@id, 'shadow-hint-')) and (local-name()='rect' or local-name()='path' or local-name()='g')]"
    [[ "$(xmllint --xpath "count($panel_shadow_selector)" "$panel_material")" == 9 &&
       "$(xmllint --xpath "count(${panel_shadow_selector}[@fill-opacity and number(@fill-opacity) <= 0.001])" "$panel_material")" == 9 &&
       "$(xmllint --xpath "count(//*[@id = 'hint-compose-over-border'])" "$panel_material")" == 0 &&
       "$(xmllint --xpath "count(//*[@id = 'hint-tile-center'])" "$panel_material")" == 1 &&
       "$(xmllint --xpath "count(//*[@id='topleft' or @id='topright' or @id='bottomleft' or @id='bottomright']/*[1]/*[local-name()='rect'])" "$panel_material")" == 0 &&
       "$(xmllint --xpath "count(//*[@id='topleft' or @id='topright' or @id='bottomleft' or @id='bottomright']/*[2]/*[local-name()='rect'])" "$panel_material")" == 0 &&
       "$(xmllint --xpath "count(//*[starts-with(@id, 'rim-')])" "$panel_material")" == 4 &&
       "$(xmllint --xpath "string(//*[@id = 'floating-hint-bottom-margin']/@height)" "$panel_material")" == 12 ]] || {
      printf 'Built image shelf material lacks the seam-safe tiled frame or floating clearance.\n' >&2
      exit 1
    }
  done
  for popup_material in "${image_popup_assets[@]}"; do
    [[ -f "$popup_material" ]] && xmllint --noout "$popup_material" || {
      printf 'Built image is missing a valid Proper popup material: %s\n' "$popup_material" >&2
      exit 1
    }
    popup_opacity="$(xmllint --xpath "string(//*[@id='center']/@fill-opacity)" "$popup_material")"
    popup_rim_color="$(xmllint --xpath "string(//*[@id='top']/*[2]/@fill)" "$popup_material")"
    popup_rim_opacity="$(xmllint --xpath "string(//*[@id='top']/*[2]/@fill-opacity)" "$popup_material")"
    [[ "$(xmllint --xpath "count(//*[@id = 'hint-compose-over-border'])" "$popup_material")" == 0 &&
       "$(xmllint --xpath "count(//*[@id = 'hint-tile-center'])" "$popup_material")" == 1 &&
       "$(xmllint --xpath "count(//*[@id='top' or @id='bottom' or @id='left' or @id='right']/*[1][@fill-opacity='$popup_opacity'])" "$popup_material")" == 4 &&
       "$(xmllint --xpath "count(//*[@id='topleft' or @id='topright' or @id='bottomleft' or @id='bottomright']/*[1][@opacity='$popup_opacity'])" "$popup_material")" == 4 &&
       "$(xmllint --xpath "count(//*[@id='topleft' or @id='topright' or @id='bottomleft' or @id='bottomright']/*[1]/*[local-name()='rect'])" "$popup_material")" == 0 &&
       "$(xmllint --xpath "count(//*[@id='top' or @id='bottom' or @id='left' or @id='right']/*[2][@fill='$popup_rim_color' and @fill-opacity='$popup_rim_opacity'])" "$popup_material")" == 4 &&
       "$(xmllint --xpath "count(//*[@id='topleft' or @id='topright' or @id='bottomleft' or @id='bottomright']/*[2][@opacity='$popup_rim_opacity']/*[local-name()='rect' and @fill='$popup_rim_color'])" "$popup_material")" == 0 ]] || {
      printf 'Built image popup material is not a uniform seam-safe nine-slice frame: %s\n' "$popup_material" >&2
      exit 1
    }
  done
  [[ "$(xmllint --xpath "string(//*[@id = 'center']/@fill-opacity)" "$image_panel_asset")" == 0.66 &&
     "$(xmllint --xpath "string(//*[@id = 'center']/@fill-opacity)" "$image_solid_panel_asset")" == 1.00 ]] || {
    printf 'Built image shelf does not contain the reviewed translucent and dense optical states.\n' >&2
    exit 1
  }
  image_popup_asset="$image_root/usr/share/plasma/desktoptheme/proper/dialogs/background.svg"
  image_popup_fill="$(xmllint --xpath "string(//*[@id = 'center']/@fill)" "$image_popup_asset")"
  image_popup_opacity="$(xmllint --xpath "string(//*[@id = 'center']/@fill-opacity)" "$image_popup_asset")"
  image_panel_fill="$(xmllint --xpath "string(//*[@id = 'center']/@fill)" "$image_panel_asset")"
  image_panel_opacity="$(xmllint --xpath "string(//*[@id = 'center']/@fill-opacity)" "$image_panel_asset")"
  [[ "$image_popup_fill" == "$image_panel_fill" &&
     "$image_popup_opacity" == "$image_panel_opacity" ]] || {
    printf 'Built image panel popups do not use the shelf material.\n' >&2
    exit 1
  }
  grep -qx 'contrast=0.72' "$image_theme_material" &&
    grep -qx 'intensity=0.82' "$image_theme_material" &&
    grep -qx 'saturation=1.15' "$image_theme_material" &&
    grep -qx 'ShellPackage=com.properlinux.desktop' "$image_root/etc/xdg/plasmashellrc" &&
    grep -qx 'BlurStrength=15' "$image_root/etc/xdg/kwinrc" &&
    grep -qx 'NoiseStrength=5' "$image_root/etc/xdg/kwinrc" &&
    grep -qx 'Saturation=150' "$image_root/etc/xdg/kwinrc" || {
      printf 'Built image does not contain the complete adaptive KWin shelf recipe.\n' >&2
      exit 1
    }
  image_control_root="$image_root/usr/share/plasma/desktoptheme/proper/widgets"
  for control_asset in button line lineedit listitem slider switch tabbar viewitem; do
    image_control_asset="$image_control_root/$control_asset.svg"
    [[ -f "$image_control_asset" ]] && xmllint --noout "$image_control_asset" || {
      printf 'Built image is missing a valid Proper Plasma control: %s.svg\n' "$control_asset" >&2
      exit 1
    }
    [[ "$(xmllint --xpath "count(//*[contains(@id, 'hint-compose-over-border')])" "$image_control_asset")" == 0 ]] || {
      printf 'Built image control asset double-composites translucent frame slices: %s\n' "$image_control_asset" >&2
      exit 1
    }
  done
  for list_state in normal hover pressed section; do
    [[ "$(xmllint --xpath "count(//*[@id='${list_state}-center'])" "$image_control_root/listitem.svg")" == 1 ]] || {
      printf 'Built image list styling is missing the %s state.\n' "$list_state" >&2
      exit 1
    }
  done
  for switch_element in inactive-center active-center handle handle-hover handle-focus handle-pressed; do
    [[ "$(xmllint --xpath "count(//*[@id='${switch_element}'])" "$image_control_root/switch.svg")" == 1 ]] || {
      printf 'Built image switch styling is missing the %s element.\n' "$switch_element" >&2
      exit 1
    }
  done
  [[ "$(xmllint --xpath "count(//*[@id = 'inactive-left' or @id = 'inactive-right' or @id = 'active-left' or @id = 'active-right'][local-name()='path'])" "$image_control_root/switch.svg")" == 4 &&
     "$(xmllint --xpath "string(//*[@id = 'hint-bar-size']/@width)" "$image_control_root/switch.svg")" == 38 &&
     "$(xmllint --xpath "string(//*[@id = 'hint-bar-size']/@height)" "$image_control_root/switch.svg")" == 16 &&
     "$(xmllint --xpath "string(//*[@id = 'handle']/@r)" "$image_control_root/switch.svg")" == 8 ]] || {
    printf 'Built image switch track or handle geometry is not the reviewed bounded design.\n' >&2
    exit 1
  }
  for lineedit_state in hover focus focusframe; do
    [[ "$(xmllint --xpath "string(//*[@id = '$lineedit_state-hint-left-margin']/@width)" "$image_control_root/lineedit.svg")" == 0.001 &&
       "$(xmllint --xpath "string(//*[@id = '$lineedit_state-hint-right-margin']/@width)" "$image_control_root/lineedit.svg")" == 0.001 &&
       "$(xmllint --xpath "string(//*[@id = '$lineedit_state-hint-top-margin']/@height)" "$image_control_root/lineedit.svg")" == 0.001 &&
       "$(xmllint --xpath "string(//*[@id = '$lineedit_state-hint-bottom-margin']/@height)" "$image_control_root/lineedit.svg")" == 0.001 ]] || {
      printf 'Built image %s line-edit layer can escape its owning applet row.\n' "$lineedit_state" >&2
      exit 1
    }
  done
  image_plasmarc="$image_root/etc/xdg/plasmarc"
  grep -qx 'Delay=900' "$image_plasmarc" || {
      printf 'Built image does not restore delayed task previews and status tooltips.\n' >&2
      exit 1
    }
  [[ -x "$image_root/usr/share/kconf_update/proper-tooltip-default-repair" &&
     -f "$image_root/usr/share/kconf_update/proper-defaults.upd" ]] || {
    printf 'Built image cannot migrate the former Delay=0 default once through kconf_update.\n' >&2
    exit 1
  }
  image_splash="$iso_dir/image-build/build/image-root/usr/share/plasma/look-and-feel/com.properlinux.dark.desktop/contents/splash/Splash.qml"
  image_ksplash="$iso_dir/image-build/build/image-root/etc/xdg/ksplashrc"
  [[ -f "$image_splash" ]] && grep -q 'proper-logo-icon.svg' "$image_splash" &&
    [[ -f "$image_ksplash" ]] && grep -qx 'Theme=com.properlinux.dark.desktop' "$image_ksplash" || {
      printf 'Built image does not select the Proper session splash.\n' >&2
      exit 1
    }
  image_desktop_layout="$image_root/usr/share/plasma/look-and-feel/com.properlinux.dark.desktop/contents/layouts/com.properlinux.desktop-layout.js"
  image_upstream_shell_layout="$image_root/usr/share/plasma/look-and-feel/com.properlinux.dark.desktop/contents/layouts/org.kde.plasma.desktop-layout.js"
  image_panel_migration="$image_root/usr/share/plasma/shells/com.properlinux.desktop/contents/updates/00-migrate-proper-panel-v1.js"
  image_status_migration="$image_root/usr/share/plasma/shells/com.properlinux.desktop/contents/updates/03-migrate-status-shade-to-shelf-v3.js"
  [[ -f "$image_desktop_layout" && -f "$image_upstream_shell_layout" && -f "$image_panel_migration" && -f "$image_status_migration" ]] &&
    cmp "$image_desktop_layout" "$image_upstream_shell_layout" &&
    grep -Fq 'tasks.writeConfig("showToolTips", true)' "$image_desktop_layout" &&
    grep -Fq 'clock.currentConfigGroup = ["Appearance"]' "$image_desktop_layout" &&
    grep -Fq 'clock.writeConfig("customDateFormat", "MMMM d")' "$image_desktop_layout" &&
    grep -Fq 'panel.addWidget("com.properlinux.statusshade")' "$image_desktop_layout" &&
    grep -Fq 'commandCentre.globalShortcut = "Meta+S"' "$image_desktop_layout" &&
    ! grep -Fq 'statusPanel' "$image_desktop_layout" &&
    grep -Fq 'panel.minimumLength === 320' "$image_panel_migration" &&
    grep -Fq 'panel.widgets().length === 1' "$image_status_migration" &&
    grep -Fq 'shelf.addWidget("com.properlinux.statusshade")' "$image_status_migration" &&
    grep -Fq 'panel.remove()' "$image_status_migration" || {
      printf 'Built image lacks the canonical Shell/Global Theme layout or bounded panel migration.\n' >&2
      exit 1
    }
  for theme in dark light midnight; do
    [[ -f "$image_root/usr/share/plasma/look-and-feel/com.properlinux.$theme.desktop/contents/layouts/com.properlinux.desktop-layout.js" ]] || {
      printf 'Built image is missing the shared Global Theme layout for %s.\n' "$theme" >&2
      exit 1
    }
  done
  for legacy in \
    kdeglobals kglobalshortcutsrc kwinrc plasmarc plasmashellrc \
    plasma-org.kde.plasma.desktop-appletsrc; do
    [[ ! -e "$image_root/etc/skel/.config/$legacy" ]] || {
      printf 'Built image still copies a layered KDE default into /etc/skel: %s\n' "$legacy" >&2
      exit 1
    }
  done
  grep -q 'function revealAuthentication()' \
    "$iso_dir/image-build/build/image-root/usr/share/plasma/shells/com.properlinux.desktop/contents/lockscreen/LockScreenUi.qml" || {
      printf 'Built image lock screen lacks the pointer authentication reveal path.\n' >&2
      exit 1
    }
  if grep -aFq 'Built on Fedora Linux' \
    "$iso_dir/image-build/build/image-root/usr/bin/proper-welcome"; then
    printf 'Built image still exposes Fedora branding in the welcome screen.\n' >&2
    exit 1
  fi
  grep -aq 'ext_background_effect_manager_v1' \
    "$iso_dir/image-build/build/image-root/usr/bin/ghostty" || {
      printf 'Built Ghostty lacks the Plasma 6 background-effect protocol.\n' >&2
      exit 1
    }
  mapfile -t image_initramfs < <(find "$iso_dir/image-build/build/image-root/boot" -maxdepth 1 -type f -name 'initramfs-*.img' ! -name 'initramfs-0-rescue-*' -print)
  (( ${#image_initramfs[@]} == 1 )) || {
    printf 'Expected exactly one normal image initramfs; found %d.\n' "${#image_initramfs[@]}" >&2
    exit 1
  }
  image_initramfs_listing="$(lsinitrd "${image_initramfs[0]}")"
  grep -q 'usr/share/plymouth/themes/proper/proper.plymouth' <<<"$image_initramfs_listing" || {
    printf 'Proper Plymouth theme is absent from the image initramfs.\n' >&2
    exit 1
  }
  mapfile -t image_bls_entries < <(find "$iso_dir/image-build/build/image-root/boot/loader/entries" -maxdepth 1 -type f -name '*.conf' -print)
  (( ${#image_bls_entries[@]} > 0 )) || {
    printf 'Built image has no boot-loader specification entries.\n' >&2
    exit 1
  }
  for bls_entry in "${image_bls_entries[@]}"; do
    grep -Eq '^title Proper Linux ' "$bls_entry" || {
      printf 'Boot entry is not branded Proper Linux: %s\n' "$bls_entry" >&2
      exit 1
    }
  done
  pvd_info="$(xorriso -indev "${images[0]}" -pvd_info 2>/dev/null)"
  grep -Eq '^Volume Id[[:space:]]*: Proper' <<<"$pvd_info" || {
    printf 'ISO volume identity is not Proper Linux.\n' >&2
    exit 1
  }
  grep -Eq '^Publisher Id[[:space:]]*: PROPER LINUX' <<<"$pvd_info" || {
    printf 'ISO publisher identity is not Proper Linux.\n' >&2
    exit 1
  }
fi
sha256sum "${images[0]}" >"${images[0]}.sha256"
printf 'Built %s\nChecksum: %s.sha256\n' "${images[0]}" "${images[0]}"
