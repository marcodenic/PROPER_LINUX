#!/usr/bin/env bash
# Build the pinned Fedora KDE 44 live ISO with Proper's reviewed overlay.
set -Eeuo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$project_root/image/upstream/fedora-kde-44.lock"
output_root="${PROPER_OUTPUT_DIR:-"$project_root/../proper-linux-build"}"
cache_root="${PROPER_CACHE_DIR:-"$output_root/cache"}"
source_dir="$cache_root/$UPSTREAM_NAME"
if [[ "${PROPER_BASELINE:-0}" == 1 ]]; then
  iso_dir="$output_root/iso/fedora-kde-44-$UPSTREAM_COMMIT"
else
  iso_dir="$output_root/iso/proper-linux-0.1-${UPSTREAM_COMMIT:0:12}"
fi
build_source_dir="$iso_dir/source"

for binary in fc-scan git lsinitrd patch sha256sum strings xmllint xorriso; do
  command -v "$binary" >/dev/null 2>&1 || { printf 'Required command missing: %s\n' "$binary" >&2; exit 1; }
done
[[ -n "$UPSTREAM_COMMIT" ]] || { printf 'Fedora input is not pinned. Run scripts/pin-fedora-base, review the lock, then rerun.\n' >&2; exit 1; }
[[ "$UPSTREAM_COMMIT" =~ ^[0-9a-f]{40}$ ]] || { printf 'Invalid UPSTREAM_COMMIT in image/upstream/fedora-kde-44.lock\n' >&2; exit 1; }

mkdir -p "$cache_root" "$iso_dir"
if [[ ! -d "$source_dir/.git" ]]; then
  git clone "$UPSTREAM_URL" "$source_dir"
fi
git -C "$source_dir" fetch --quiet origin "$UPSTREAM_COMMIT"
git -C "$source_dir" checkout --detach --quiet "$UPSTREAM_COMMIT"

rm -rf "$build_source_dir"
mkdir -p "$build_source_dir"
  cp -a "$source_dir/." "$build_source_dir/"
  # Fedora's KDE profile explicitly pulls the LibreOffice collection. Proper
  # keeps the base image lean and offers office software through the future
  # catalogue, so apply this narrow profile-local exclusion to the pinned
  # upstream description during composition.
  sed -i '/<namedCollection name="libreoffice"\/>/d; /<package name="libreoffice-/d; /<package name="plasma-welcome-fedora"\/>/d' \
    "$build_source_dir/components/desktops/kde.xml"
  sed -i '/<package name="mediawriter"\/>/d' \
    "$build_source_dir/components/desktops/common.xml"
  sed -i '/<package name="plasma-welcome-fedora"\/>/d' \
    "$build_source_dir/teams/kde.xml"
if [[ "${PROPER_BASELINE:-0}" == 1 ]]; then
  kiwi_file=/source/Fedora.kiwi
else
  # Repository existence does not prove that its RPM payloads match the
  # current source tree. Rebuild the curated set for every product image.
  PROPER_OUTPUT_DIR="$output_root" "$project_root/scripts/build-rpms"
  cp -a "$project_root/image/descriptions/proper.xml" "$build_source_dir/proper.xml"
  patch --batch --forward -d "$build_source_dir" -p1 < "$project_root/image/descriptions/proper-media.patch"
  # Fedora's upstream hook ends with `exit 0`.  Insert our live-session hook
  # before that terminator so KIWI actually executes it while composing the
  # image rather than leaving it as unreachable text.
  sed -i '${/^exit 0$/d;}' "$build_source_dir/config.sh"
  cat "$project_root/image/descriptions/proper-live-config.sh" >> "$build_source_dir/config.sh"
  printf '\nexit 0\n' >> "$build_source_dir/config.sh"
  cp -a "$output_root/repo" "$build_source_dir/repo"
  # Fedora's label generator parses Fedora.kiwi directly, so preserve it as
  # the top-level document and append only the Proper overlay.
  sed -i 's#</image>#\t<include from="this://./proper.xml"/>\n</image>#' "$build_source_dir/Fedora.kiwi"
  kiwi_file=/source/Fedora.kiwi
fi

# KIWI refuses to reuse an incomplete root from a failed build. This directory
# is generated beneath the selected ISO output and contains no source files.
# A rootless container owns some image-root files in its user namespace.
if [[ -d "$iso_dir/image-build" ]]; then
  if [[ "$(id -u)" -eq 0 ]]; then
    rm -rf "$iso_dir/image-build"
  elif command -v podman >/dev/null 2>&1; then
    podman unshare rm -rf "$iso_dir/image-build"
  else
    printf 'Cannot remove generated KIWI state without root or Podman: %s\n' "$iso_dir/image-build" >&2
    exit 1
  fi
fi

using_container=0
if command -v kiwi-ng >/dev/null 2>&1 && [[ "$(id -u)" -eq 0 ]]; then
  runner=()
elif command -v kiwi-ng >/dev/null 2>&1 && command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1; then
  runner=(sudo)
elif command -v podman >/dev/null 2>&1; then
  using_container=1
  builder_image="localhost/proper-linux-kiwi-builder:fedora44"
  mkdir -p "$iso_dir/tmp"
  podman build --tag "$builder_image" --file "$project_root/image/Containerfile" "$project_root/image"
  podman run --rm --privileged --volume "$build_source_dir:/source:Z" --volume "$iso_dir:/output:Z" --volume "$iso_dir/tmp:/var/tmp:Z" "$builder_image" /source/kiwi-build --kiwi-file="$kiwi_file" --image-type="$IMAGE_TYPE" --image-profile="$IMAGE_PROFILE" --output-dir=/output/image 2>&1 | tee "$iso_dir/kiwi-build.log"
  runner=()
else
  printf 'KIWI requires root/sudo or a functional Podman runtime.\n' >&2
  exit 1
fi

if (( using_container == 0 )); then
  local_kiwi_file="${kiwi_file#/source}"
  "${runner[@]}" "$build_source_dir/kiwi-build" --kiwi-file="$build_source_dir$local_kiwi_file" --image-type="$IMAGE_TYPE" --image-profile="$IMAGE_PROFILE" --output-dir="$iso_dir"
fi

mapfile -t images < <(find "$iso_dir" -maxdepth 3 -type f -name '*.iso' -print)
(( ${#images[@]} == 1 )) || { printf 'Expected exactly one ISO in %s; found %d.\n' "$iso_dir" "${#images[@]}" >&2; exit 1; }
if [[ "${PROPER_BASELINE:-0}" != 1 ]]; then
  mapfile -t package_manifests < <(find "$iso_dir" -maxdepth 3 -type f -name '*.packages' -print)
  (( ${#package_manifests[@]} == 1 )) || {
    printf 'Expected exactly one package manifest in %s; found %d.\n' "$iso_dir" "${#package_manifests[@]}" >&2
    exit 1
  }
  if grep -Eq '^initial-setup(\||-)' "${package_manifests[0]}"; then
    printf 'Legacy initial-setup packages entered the Proper image; Fedora KDE must use plasma-setup.\n' >&2
    exit 1
  fi
  grep -Eq '^plasma-setup\|' "${package_manifests[0]}" || {
    printf 'Fedora plasma-setup is missing from the Proper image package manifest.\n' >&2
    exit 1
  }
  for package in proper-release proper-branding proper-welcome; do
    grep -Eq "^${package}\\|" "${package_manifests[0]}" || {
      printf 'Required arrival package is missing from the Proper image: %s\n' "$package" >&2
      exit 1
    }
  done
  grep -Eq '^proper-look-and-feel\|\(none\)\|0[.]1\|21[.]fc44\|' "${package_manifests[0]}" || {
    printf 'Built image does not contain the Inter-based Proper shell package release.\n' >&2
    exit 1
  }
  grep -Eq '^proper-defaults\|\(none\)\|0[.]1\|21[.]fc44\|' "${package_manifests[0]}" || {
    printf 'Built image does not contain the Inter-based desktop defaults release.\n' >&2
    exit 1
  }
  grep -Eq '^plasma-desktop\|\(none\)\|6[.]7[.]4\|1[.]fc44[.]proper1\|' "${package_manifests[0]}" || {
    printf 'Built image does not contain the pinned Proper task-launch indicator patch.\n' >&2
    exit 1
  }
  grep -Eq '^plasma-login-manager\|\(none\)\|6[.]7[.]4\|1[.]proper3[.]fc44\|' "${package_manifests[0]}" || {
    printf 'Built image does not contain the Inter-based Proper login composition.\n' >&2
    exit 1
  }
  grep -Eq '^proper-branding\|\(none\)\|0[.]1\|3[.]fc44\|' "${package_manifests[0]}" || {
    printf 'Built image does not contain the Inter-based Proper boot branding release.\n' >&2
    exit 1
  }
  grep -Eq '^proper-terminal\|\(none\)\|1[.]3[.]1\|3[.]fc44\|' "${package_manifests[0]}" || {
    printf 'Built image does not contain the JetBrains-Mono-declared Ghostty package release.\n' >&2
    exit 1
  }
  grep -Eq '^proper-welcome\|\(none\)\|0[.]1\|6[.]fc44\|' "${package_manifests[0]}" || {
    printf 'Built image does not contain the Inter-token welcome and Start Here release.\n' >&2
    exit 1
  }
  grep -Eq '^proper-apps\|\(none\)\|0[.]1\|9[.]fc44\|' "${package_manifests[0]}" || {
    printf 'Built image does not contain the Inter-token Proper Apps release.\n' >&2
    exit 1
  }
  grep -Eq '^proper-appearance\|\(none\)\|0[.]1\|5[.]fc44\|' "${package_manifests[0]}" || {
    printf 'Built image does not contain the Inter-preserving Appearance release.\n' >&2
    exit 1
  }
  grep -Eq '^proper-launchers\|\(none\)\|0[.]1\|13[.]fc44\|' "${package_manifests[0]}" || {
    printf 'Built image does not contain the Inter-token shortcut reference release.\n' >&2
    exit 1
  }
  grep -Eq '^rsms-inter-fonts\|\(none\)\|4[.]1\|3[.]fc44\|' "${package_manifests[0]}" || {
    printf 'Fedora Inter 4.1 package is missing or changed without review.\n' >&2
    exit 1
  }
  grep -Eq '^google-noto-sans-fonts\|' "${package_manifests[0]}" || {
    printf 'Noto Sans fallback package is missing from the Proper image.\n' >&2
    exit 1
  }
  grep -Eq '^jetbrains-mono-fonts\|' "${package_manifests[0]}" || {
    printf 'JetBrains Mono terminal font package is missing from the Proper image.\n' >&2
    exit 1
  }
  if grep -Eq '^fedora-release-identity-kde-desktop\|' "${package_manifests[0]}"; then
    printf 'Fedora KDE edition identity remained installed beside proper-release.\n' >&2
    exit 1
  fi
  grep -Eq '^generic-logos\|' "${package_manifests[0]}" || {
    printf 'Generic system-logo compatibility package is missing from the Proper image.\n' >&2
    exit 1
  }
  if grep -Eq '^fedora-logos\|' "${package_manifests[0]}"; then
    printf 'Fedora official logo package remained in the Proper image.\n' >&2
    exit 1
  fi
  image_os_release="$iso_dir/image-build/build/image-root/usr/lib/os-release"
  [[ -f "$image_os_release" ]] && grep -qx 'ID=proper' "$image_os_release" || {
    printf 'Built image does not identify itself as Proper Linux: %s\n' "$image_os_release" >&2
    exit 1
  }
  image_plymouth_config="$iso_dir/image-build/build/image-root/etc/plymouth/plymouthd.conf"
  [[ -f "$image_plymouth_config" ]] && grep -qx 'Theme=proper' "$image_plymouth_config" || {
    printf 'Built image does not select the Proper Plymouth theme: %s\n' "$image_plymouth_config" >&2
    exit 1
  }
  image_dark_scheme="$iso_dir/image-build/build/image-root/usr/share/color-schemes/Proper.colors"
  image_kdeglobals="$iso_dir/image-build/build/image-root/etc/xdg/kdeglobals"
  image_root="$iso_dir/image-build/build/image-root"
  dark_window_rgb="$(awk '
    /^\[Colors:Window\]$/ { in_window = 1; next }
    /^\[/ { in_window = 0 }
    in_window && /^BackgroundNormal=/ { sub(/^BackgroundNormal=/, ""); print; exit }
  ' "$image_dark_scheme")"
  IFS=, read -r dark_red dark_green dark_blue <<<"$dark_window_rgb"
  [[ "$dark_red" =~ ^[0-9]+$ && "$dark_green" =~ ^[0-9]+$ && "$dark_blue" =~ ^[0-9]+$ ]] &&
    (( dark_red < 80 && dark_green < 80 && dark_blue < 80 )) || {
      printf 'Proper Dark image palette is not dark: %s\n' "${dark_window_rgb:-missing}" >&2
      exit 1
    }
  grep -q '^\[Colors:View\]$' "$image_kdeglobals" &&
    grep -qx 'BackgroundNormal=21,26,34' "$image_kdeglobals" || {
      printf 'Built image does not seed the complete dark Proper application palette.\n' >&2
      exit 1
    }
  for font_default in \
    'desktopFont=Inter,10,-1,5,50,0,0,0,0,0' \
    'font=Inter,10,-1,5,50,0,0,0,0,0' \
    'menuFont=Inter,10,-1,5,50,0,0,0,0,0' \
    'smallestReadableFont=Inter,8,-1,5,50,0,0,0,0,0' \
    'toolBarFont=Inter,9,-1,5,50,0,0,0,0,0' \
    'activeFont=Inter,9,-1,5,50,0,0,0,0,0'; do
    grep -Fqx "$font_default" "$image_kdeglobals" || {
      printf 'Built image is missing an Inter KDE default: %s\n' "$font_default" >&2
      exit 1
    }
  done
  grep -Fqx 'fixed=JetBrains Mono,10,-1,5,50,0,0,0,0,0' "$image_kdeglobals" || {
    printf 'Built image does not retain JetBrains Mono for fixed-width KDE text.\n' >&2
    exit 1
  }
  for gtk_version in 3.0 4.0; do
    grep -Fqx 'gtk-font-name=Inter 10' "$image_root/etc/gtk-$gtk_version/settings.ini" || {
      printf 'Built image GTK %s default is not Inter.\n' "$gtk_version" >&2
      exit 1
    }
  done
  image_inter_font="$image_root/usr/share/fonts/rsms-inter-fonts/Inter-Regular.ttf"
  [[ -f "$image_inter_font" ]] || {
    printf 'Built image is missing Inter-Regular.ttf.\n' >&2
    exit 1
  }
  [[ "$(fc-scan --format '%{family[0]}|%{fontversion}\n' "$image_inter_font")" == 'Inter|262210' ]] || {
    printf 'Built Inter font family or OpenType version differs from the reviewed Inter 4 payload.\n' >&2
    exit 1
  }
  find "$image_root/usr/share/fonts" -type f -name 'NotoSans-Regular.ttf' -print -quit | grep -q . || {
    printf 'Built image has no Noto Sans regular fallback file.\n' >&2
    exit 1
  }
  image_jetbrains_font="$image_root/usr/share/fonts/jetbrains-mono-fonts/JetBrainsMono-Regular.otf"
  [[ -f "$image_jetbrains_font" ]] || {
    printf 'Built image has no Fedora JetBrains Mono regular OTF.\n' >&2
    exit 1
  }
  [[ "$(fc-scan --format '%{family[0]}|%{style[0]}|%{fontversion}\n' "$image_jetbrains_font")" == 'JetBrains Mono|Regular|150995' ]] || {
    printf 'Built JetBrains Mono family, style, or OpenType version differs from the reviewed Fedora payload.\n' >&2
    exit 1
  }
  image_widgets="$image_root/usr/share/proper-linux/ui/proper-widgets-dark.qss"
  image_web="$image_root/usr/share/proper-linux/ui/proper-web.css"
  grep -Fq 'font-family: "Inter";' "$image_widgets" || {
    printf 'Built first-party Qt UI assets do not select Inter.\n' >&2
    exit 1
  }
  grep -Fq 'font-family: Inter, "Noto Sans", sans-serif;' "$image_web" || {
    printf 'Built shortcut-reference CSS does not use the Inter/Noto fallback chain.\n' >&2
    exit 1
  }
  image_lock_qml="$image_root/usr/share/plasma/shells/com.properlinux.desktop/contents/lockscreen/LockScreenUi.qml"
  grep -Fq 'readonly property string uiFontFamily: "Inter"' "$image_lock_qml" || {
    printf 'Built lock screen does not select Inter explicitly.\n' >&2
    exit 1
  }
  image_login_strings="$(strings -el "$image_root/usr/libexec/plasma-login-greeter")"
  grep -Fxq 'uiFontFamily' <<<"$image_login_strings" &&
    grep -Fxq 'Inter' <<<"$image_login_strings" || {
      printf 'Built login greeter does not embed the explicit Inter family.\n' >&2
      exit 1
    }
  image_task_strings="$(strings -el \
    "$iso_dir/image-build/build/image-root/usr/lib64/qt6/plugins/plasma/applets/org.kde.plasma.taskmanager.so")"
  grep -Fxq 'launchIndicator' <<<"$image_task_strings" || {
      printf 'Built task manager plugin lacks the Proper moving-dot launch state.\n' >&2
      exit 1
    }
  image_ghostty_config="$iso_dir/image-build/build/image-root/etc/xdg/ghostty/config"
  grep -Fqx 'font-family = JetBrains Mono' "$image_ghostty_config" || {
    printf 'Built Ghostty configuration no longer selects JetBrains Mono.\n' >&2
    exit 1
  }
  grep -qx 'background-opacity = 0.88' "$image_ghostty_config" || {
    printf 'Built image does not contain the approved visible Ghostty translucency.\n' >&2
    exit 1
  }
  [[ -x "$iso_dir/image-build/build/image-root/usr/bin/proper-welcome-launch" ]] || {
    printf 'Built image is missing the live welcome display launcher.\n' >&2
    exit 1
  }
  image_task_asset="$iso_dir/image-build/build/image-root/usr/share/plasma/desktoptheme/proper/widgets/tasks.svg"
  [[ -f "$image_task_asset" ]] &&
    xmllint --xpath "count(//*[@id = 'focus-bottom'])" "$image_task_asset" 2>/dev/null | grep -qx 1 &&
    xmllint --xpath "count(//*[@id = 'normal-bottom'])" "$image_task_asset" 2>/dev/null | grep -qx 1 || {
      printf 'Built image is missing the approved active-line and running-dot task states.\n' >&2
      exit 1
    }
  image_splash="$iso_dir/image-build/build/image-root/usr/share/plasma/look-and-feel/com.properlinux.dark.desktop/contents/splash/Splash.qml"
  image_ksplash="$iso_dir/image-build/build/image-root/etc/xdg/ksplashrc"
  [[ -f "$image_splash" ]] && grep -q 'proper-logo-icon.svg' "$image_splash" &&
    [[ -f "$image_ksplash" ]] && grep -qx 'Theme=com.properlinux.dark.desktop' "$image_ksplash" || {
      printf 'Built image does not select the Proper session splash.\n' >&2
      exit 1
    }
  grep -q 'function revealAuthentication()' \
    "$iso_dir/image-build/build/image-root/usr/share/plasma/shells/com.properlinux.desktop/contents/lockscreen/LockScreenUi.qml" || {
      printf 'Built image lock screen lacks the pointer authentication reveal path.\n' >&2
      exit 1
    }
  if grep -aFq 'Built on Fedora Linux' \
    "$iso_dir/image-build/build/image-root/usr/bin/proper-welcome"; then
    printf 'Built image still exposes Fedora branding in the welcome screen.\n' >&2
    exit 1
  fi
  grep -aq 'ext_background_effect_manager_v1' \
    "$iso_dir/image-build/build/image-root/usr/bin/ghostty" || {
      printf 'Built Ghostty lacks the Plasma 6 background-effect protocol.\n' >&2
      exit 1
    }
  mapfile -t image_initramfs < <(find "$iso_dir/image-build/build/image-root/boot" -maxdepth 1 -type f -name 'initramfs-*.img' ! -name 'initramfs-0-rescue-*' -print)
  (( ${#image_initramfs[@]} == 1 )) || {
    printf 'Expected exactly one normal image initramfs; found %d.\n' "${#image_initramfs[@]}" >&2
    exit 1
  }
  image_initramfs_listing="$(lsinitrd "${image_initramfs[0]}")"
  grep -q 'usr/share/plymouth/themes/proper/proper.plymouth' <<<"$image_initramfs_listing" || {
    printf 'Proper Plymouth theme is absent from the image initramfs.\n' >&2
    exit 1
  }
  mapfile -t image_bls_entries < <(find "$iso_dir/image-build/build/image-root/boot/loader/entries" -maxdepth 1 -type f -name '*.conf' -print)
  (( ${#image_bls_entries[@]} > 0 )) || {
    printf 'Built image has no boot-loader specification entries.\n' >&2
    exit 1
  }
  for bls_entry in "${image_bls_entries[@]}"; do
    grep -Eq '^title Proper Linux ' "$bls_entry" || {
      printf 'Boot entry is not branded Proper Linux: %s\n' "$bls_entry" >&2
      exit 1
    }
  done
  pvd_info="$(xorriso -indev "${images[0]}" -pvd_info 2>/dev/null)"
  grep -Eq '^Volume Id[[:space:]]*: Proper' <<<"$pvd_info" || {
    printf 'ISO volume identity is not Proper Linux.\n' >&2
    exit 1
  }
  grep -Eq '^Publisher Id[[:space:]]*: PROPER LINUX' <<<"$pvd_info" || {
    printf 'ISO publisher identity is not Proper Linux.\n' >&2
    exit 1
  }
fi
sha256sum "${images[0]}" >"${images[0]}.sha256"
printf 'Built %s\nChecksum: %s.sha256\n' "${images[0]}" "${images[0]}"
