#!/usr/bin/env bash
# Validate the canonical Proper identity and every supported arrival seam.
set -Eeuo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
wordmark="$project_root/packages/proper-branding/proper-wordmark.svg"
os_release="$project_root/packages/proper-release/os-release"
profile="$project_root/packages/proper-release/proper-anaconda.conf"
media_patch="$project_root/image/descriptions/proper-media.patch"
live_hook="$project_root/image/descriptions/proper-live-config.sh"
firmware_lock="$project_root/image/firmware/edk2-ovmf-fedora44.lock"

for binary in desktop-file-validate identify xmllint; do
  command -v "$binary" >/dev/null 2>&1 || {
    printf 'Required arrival validator is missing: %s\n' "$binary" >&2
    exit 1
  }
done

xmllint --noout \
  "$wordmark" \
  "$project_root/packages/proper-branding/proper-wordmark-dark.svg" \
  "$project_root/packages/proper-branding/proper-logo-icon.svg" \
  "$project_root/packages/proper-release/org.properlinux.ProperLinux-0.1.swidtag"

cell_count="$(rg -o '<use ' "$wordmark" | wc -l)"
[[ "$cell_count" -eq 80 ]] || {
  printf 'Canonical Proper wordmark must contain 80 grid cells; found %s.\n' "$cell_count" >&2
  exit 1
}

grep -qx 'ID=proper' "$os_release"
grep -qx 'ID_LIKE=fedora' "$os_release"
grep -qx 'LOGO=proper-logo-icon' "$os_release"
grep -qx 'base_profile = fedora-kde' "$profile"
grep -qx 'os_id = proper' "$profile"
grep -qx 'custom_stylesheet = /usr/share/anaconda/pixmaps/proper.css' "$profile"

grep -q 'publisher="Proper Linux"' "$media_patch"
grep -q 'menuentry "Start Proper Linux"' "$media_patch"
grep -q 'set default="0"' "$media_patch"
grep -q 'proper-welcome.desktop' "$live_hook"
grep -q 'Hidden=true' "$live_hook"
grep -q 'Install\\ Proper\\ Linux.desktop' "$live_hook"
grep -q '<package name="generic-logos"/>' "$project_root/image/descriptions/proper.xml"
grep -q '<ignore name="fedora-logos"/>' "$project_root/image/descriptions/proper.xml"

grep -qx 'ModuleName=two-step' "$project_root/packages/proper-branding/proper.plymouth"
grep -qx 'BackgroundStartColor=0x050608' "$project_root/packages/proper-branding/proper.plymouth"
grep -qx 'EDK2_SOURCE_NEVRA="edk2-20260508-8.fc44"' "$firmware_lock"
grep -qx 'EDK2_SOURCE_RPM_SHA256="2dc18705f149274cccb0ecd5a184bb9602e4fde57e0f448b9af674502117b5a4"' "$firmware_lock"
grep -qx 'EDK2_SOURCE_DATE_EPOCH="1785888000"' "$firmware_lock"
grep -q 'proper-ovmf-logo.bmp' "$project_root/scripts/build-vm-firmware"
grep -q -- '-compress none "BMP3:$logo"' "$project_root/scripts/build-vm-firmware"
grep -q 'firmware_profile="${PROPER_VM_FIRMWARE:-proper}"' "$project_root/scripts/run-vm"
grep -q '/EFI/fedora/shimx64.efi' "$project_root/image/firmware/quiet-successful-boot.patch"
grep -q 'QProcess::startDetached("/usr/bin/liveinst"' "$project_root/packages/proper-welcome/main.cpp"

desktop-file-validate \
  "$project_root/packages/proper-welcome/proper-welcome.desktop" \
  "$project_root/packages/proper-welcome/proper-install.desktop"

bash -n \
  "$project_root/packages/proper-branding/generate-plymouth-assets.sh" \
  "$project_root/scripts/build-vm-firmware" \
  "$project_root/scripts/run-vm" \
  "$live_hook"

printf 'Proper arrival valid: canonical grid mark, product identity, installer inheritance, Plymouth, media, and live welcome.\n'
