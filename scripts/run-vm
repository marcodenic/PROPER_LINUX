#!/usr/bin/env bash
# Boot a Proper/Fedora live ISO in a local UEFI QEMU/KVM window.
#
# The HMP socket is retained for observation (including screendump), while the
# QMP socket is the supported input/control path for graphical acceptance.
# Relative mouse input is the PM-review default because QEMU's absolute pointer
# can be mis-scaled by XWayland on a HiDPI host display. Set
# PROPER_VM_POINTER=tablet only for controlled absolute-input automation.
# The default PM-review presentation uses a normal resizable local GTK window
# with a 1920x1080 framebuffer at 100% scaling. The guest is zoomed to fit the
# client area, so maximising the window fills it instead of leaving a small
# centred guest surface. Set
# PROPER_VM_PROFILE=hidpi for a 3840x2160 framebuffer at 200% scaling.
# Forced full-screen launch is deliberately unsupported. VNC is an automation
# backend and does not open a local review window.
# Set PROPER_VM_BOOT=installed to omit the ISO after installation, and set
# PROPER_VM_OUTPUTS=2 for the focused multi-display compatibility view.
set -Eeuo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
iso_path="${1:?Usage: scripts/run-vm /absolute/path/to/image.iso [vm-disk.qcow2]}"
disk_path="${2:-"$project_root/../proper-linux-build/vm/proper-linux.qcow2"}"
source "$project_root/image/firmware/edk2-ovmf-fedora44.lock"
output_root="${PROPER_OUTPUT_DIR:-"$project_root/../proper-linux-build"}"
firmware_profile="${PROPER_VM_FIRMWARE:-proper}"
if [[ -n "${OVMF_CODE:-}" || -n "${OVMF_VARS:-}" ]]; then
  firmware_profile=custom
  firmware_code="${OVMF_CODE:-/usr/share/edk2/ovmf/OVMF_CODE.fd}"
  firmware_vars_template="${OVMF_VARS:-/usr/share/edk2/ovmf/OVMF_VARS.fd}"
else
  case "$firmware_profile" in
    proper)
      firmware_code="$output_root/firmware/$EDK2_FIRMWARE_BUILD_ID/OVMF_CODE.fd"
      firmware_vars_template="$output_root/firmware/$EDK2_FIRMWARE_BUILD_ID/OVMF_VARS.fd"
      ;;
    host)
      firmware_code=/usr/share/edk2/ovmf/OVMF_CODE.fd
      firmware_vars_template=/usr/share/edk2/ovmf/OVMF_VARS.fd
      ;;
    *)
      printf 'Unknown VM firmware profile: %s (use proper or host).\n' "$firmware_profile" >&2
      exit 1
      ;;
  esac
fi
vm_dir="$(dirname "$disk_path")"
disk_stem="$(basename "${disk_path%.*}")"
firmware_vars="$vm_dir/$disk_stem.OVMF_VARS.fd"
monitor_socket="$vm_dir/$disk_stem.monitor.sock"
qmp_socket="$vm_dir/$disk_stem.qmp.sock"
vm_profile="${PROPER_VM_PROFILE:-fullhd}"
case "$vm_profile" in
  hidpi|retina|macbook)
    profile_width=3840
    profile_height=2160
    profile_scale=2
    ;;
  fullhd|1080p)
    profile_width=1920
    profile_height=1080
    profile_scale=1
    ;;
  custom)
    profile_width="${PROPER_VM_WIDTH:?PROPER_VM_WIDTH is required for the custom profile.}"
    profile_height="${PROPER_VM_HEIGHT:?PROPER_VM_HEIGHT is required for the custom profile.}"
    profile_scale="${PROPER_VM_SCALE:?PROPER_VM_SCALE is required for the custom profile.}"
    ;;
  *)
    printf 'Unknown VM display profile: %s (use hidpi, fullhd, or custom).\n' "$vm_profile" >&2
    exit 1
    ;;
esac
vm_width="${PROPER_VM_WIDTH:-$profile_width}"
vm_height="${PROPER_VM_HEIGHT:-$profile_height}"
vm_scale="${PROPER_VM_SCALE:-$profile_scale}"
vm_refresh="${PROPER_VM_REFRESH:-60}"
vm_memory="${PROPER_VM_MEMORY:-8192}"
vm_boot="${PROPER_VM_BOOT:-live}"
vm_outputs="${PROPER_VM_OUTPUTS:-1}"
vm_ssh_port="${PROPER_VM_SSH_PORT:-}"
vm_display_delay="${PROPER_VM_DISPLAY_DELAY:-35}"
vm_auto_display="${PROPER_VM_AUTO_DISPLAY:-1}"
vm_backend="${PROPER_VM_BACKEND:-gtk}"
vm_vnc_display="${PROPER_VM_VNC_DISPLAY:-}"
if [[ -n "${PROPER_VM_FULLSCREEN:-}" && ! "${PROPER_VM_FULLSCREEN}" =~ ^(0|off|false)$ ]]; then
  printf 'Forced full-screen VM launch is unsupported; maximise the normal review window instead.\n' >&2
  exit 1
fi
vm_pointer="${PROPER_VM_POINTER:-relative}"
case "$vm_pointer" in
  tablet) pointer_args=(-device qemu-xhci -device usb-tablet,id=proper_tablet) ;;
  relative) pointer_args=(-device qemu-xhci) ;;
  *) printf 'Unknown VM pointer: %s (use tablet or relative).\n' "$vm_pointer" >&2; exit 1 ;;
esac
case "$vm_backend" in
  gtk) display_args=(-display gtk,gl=off,zoom-to-fit=on,keep-aspect-ratio=on) ;;
  vnc)
    # QEMU's display number is global on the host; derive a stable default from
    # the disk name, while allowing callers to select another unused display.
    if [[ -z "$vm_vnc_display" ]]; then
      vm_vnc_display=$((90 + $(cksum <<<"$disk_path" | awk '{print $1 % 10}')))
    fi
    [[ "$vm_vnc_display" =~ ^[0-9]+$ ]] || { printf 'PROPER_VM_VNC_DISPLAY must be a QEMU VNC display number (port 5900+N).\n' >&2; exit 1; }
    display_args=(-display "vnc=127.0.0.1:${vm_vnc_display}")
    ;;
  *) printf 'Unknown VM backend: %s (use gtk or vnc).\n' "$vm_backend" >&2; exit 1 ;;
esac
aux_drive_args=()
if [[ -n "${PROPER_VM_AUX_ISO:-}" ]]; then
  [[ -f "$PROPER_VM_AUX_ISO" ]] || { printf 'Auxiliary VM ISO not found: %s\n' "$PROPER_VM_AUX_ISO" >&2; exit 1; }
  aux_drive_args=(-drive "file=$PROPER_VM_AUX_ISO,media=cdrom,if=none,format=raw,readonly=on,id=proper_aux" -device ide-cd,drive=proper_aux)
elif [[ -n "${PROPER_VM_AUX_DISK:-}" ]]; then
  [[ -f "$PROPER_VM_AUX_DISK" ]] || { printf 'Auxiliary VM disk not found: %s\n' "$PROPER_VM_AUX_DISK" >&2; exit 1; }
  aux_drive_args=(-drive "file=$PROPER_VM_AUX_DISK,if=virtio,format=raw,readonly=on")
fi

case "$vm_boot" in
  live)
    [[ -f "$iso_path" ]] || { printf 'ISO not found: %s\n' "$iso_path" >&2; exit 1; }
    # Explicit device boot indexes override persistent OVMF entries left by a
    # completed installation, so live mode cannot silently boot the disk.
    disk_bootindex=2
    media_args=(-drive "file=$iso_path,media=cdrom,if=none,format=raw,readonly=on,id=proper_live" -device ide-cd,drive=proper_live,bootindex=1 -boot menu=on)
    ;;
  installed)
    [[ -f "$disk_path" ]] || { printf 'Installed VM disk not found: %s\n' "$disk_path" >&2; exit 1; }
    disk_bootindex=1
    media_args=(-boot menu=on)
    ;;
  *) printf 'Unknown VM boot mode: %s (use live or installed).\n' "$vm_boot" >&2; exit 1 ;;
esac
[[ "$vm_width" =~ ^[0-9]+$ && "$vm_height" =~ ^[0-9]+$ ]] || { printf 'VM dimensions must be positive integers.\n' >&2; exit 1; }
[[ "$vm_scale" =~ ^[0-9]+([.][0-9]+)?$ ]] || { printf 'VM scale must be a positive number.\n' >&2; exit 1; }
[[ "$vm_refresh" =~ ^[0-9]+([.][0-9]+)?$ ]] || { printf 'VM refresh must be a positive number.\n' >&2; exit 1; }
[[ "$vm_memory" =~ ^[0-9]+$ && "$vm_memory" -ge 1024 ]] || { printf 'PROPER_VM_MEMORY must be at least 1024 megabytes.\n' >&2; exit 1; }
[[ "$vm_outputs" =~ ^[1-4]$ ]] || { printf 'PROPER_VM_OUTPUTS must be an integer from 1 to 4.\n' >&2; exit 1; }
gpu_args=(-device "virtio-vga,xres=$vm_width,yres=$vm_height,max_outputs=1")
# QEMU 10.2 exposes extra scanout capacity through max_outputs but leaves all
# heads after the first disconnected.  Give each requested compatibility-view
# output its own virtio controller so Plasma sees a real connected display.
for ((output_index = 2; output_index <= vm_outputs; output_index++)); do
  gpu_args+=(-device "virtio-gpu-pci,id=proper_gpu_$output_index,xres=$vm_width,yres=$vm_height,max_outputs=1")
done
if [[ -n "$vm_ssh_port" ]]; then
  [[ "$vm_ssh_port" =~ ^[0-9]+$ && "$vm_ssh_port" -ge 1024 && "$vm_ssh_port" -le 65535 ]] || {
    printf 'PROPER_VM_SSH_PORT must be an unprivileged TCP port from 1024 to 65535.\n' >&2
    exit 1
  }
  network_args=(-nic "user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:${vm_ssh_port}-:22")
else
  network_args=(-nic user,model=virtio-net-pci)
fi
[[ "$vm_display_delay" =~ ^[0-9]+$ ]] || { printf 'VM display delay must be a non-negative integer.\n' >&2; exit 1; }
[[ "$vm_auto_display" == 0 || "$vm_auto_display" == 1 ]] || { printf 'PROPER_VM_AUTO_DISPLAY must be 0 or 1.\n' >&2; exit 1; }
[[ -c /dev/kvm && -r /dev/kvm && -w /dev/kvm ]] || { printf '/dev/kvm is unavailable; graphical acceptance requires host KVM access.\n' >&2; exit 1; }
command -v qemu-system-x86_64 >/dev/null || { printf 'qemu-system-x86_64 is not installed.\n' >&2; exit 1; }
if [[ ! -f "$firmware_code" || ! -f "$firmware_vars_template" ]]; then
  if [[ "$firmware_profile" == proper ]]; then
    printf 'Proper-branded OVMF firmware is missing. Build it with scripts/build-vm-firmware.\n' >&2
    printf 'Use PROPER_VM_FIRMWARE=host only for raw upstream-firmware diagnostics.\n' >&2
  else
    printf 'OVMF firmware not found; set OVMF_CODE and OVMF_VARS to valid paths.\n' >&2
  fi
  exit 1
fi

# Refuse to start a second VM using this disk.  Match the fully resolved disk
# path in the command line so an unrelated QEMU process cannot be mistaken
# for this acceptance VM.
disk_realpath="$(realpath -e "$disk_path" 2>/dev/null || realpath -m "$disk_path")"
while read -r pid args; do
  [[ -n "${pid:-}" && "$pid" != "$$" ]] || continue
  if grep -Fq -- "$disk_realpath" <<<"$args"; then
    printf 'A Proper Linux VM is already running for disk %s (PID %s).\n' "$disk_realpath" "$pid" >&2
    printf 'Reuse its QMP socket: %s\n' "$qmp_socket" >&2
    exit 1
  fi
done < <(ps -eo pid=,args= | grep '[q]emu-system-x86_64' || true)

mkdir -p "$vm_dir"
[[ -f "$firmware_vars" ]] || cp "$firmware_vars_template" "$firmware_vars"
[[ -f "$disk_path" ]] || qemu-img create -f qcow2 "$disk_path" 64G
if [[ -e "$monitor_socket" || -e "$qmp_socket" ]]; then
  for socket in "$monitor_socket" "$qmp_socket"; do
    [[ ! -e "$socket" ]] || [[ -S "$socket" ]] || { printf 'Refusing to overwrite non-socket path: %s\n' "$socket" >&2; exit 1; }
    [[ ! -e "$socket" ]] || { printf 'Stale VM socket must be removed after verifying the old VM is gone: %s\n' "$socket" >&2; exit 1; }
  done
fi

qemu-system-x86_64 -enable-kvm -machine q35,accel=kvm -cpu host -smp 8 -m "$vm_memory" "${gpu_args[@]}" "${pointer_args[@]}" "${display_args[@]}" -monitor "unix:$monitor_socket,server=on,wait=off" -qmp "unix:$qmp_socket,server=on,wait=off" -drive if=pflash,format=raw,readonly=on,file="$firmware_code" -drive if=pflash,format=raw,file="$firmware_vars" -drive "file=$disk_path,if=none,format=qcow2,id=proper_disk" -device "virtio-blk-pci,drive=proper_disk,bootindex=$disk_bootindex" "${aux_drive_args[@]}" "${media_args[@]}" "${network_args[@]}" &
qemu_pid=$!
display_helper_pid=

printf 'VM firmware profile %s: %s\n' "$firmware_profile" "$firmware_code"

cleanup_display_helper() {
  if [[ -n "${display_helper_pid:-}" ]] && kill -0 "$display_helper_pid" 2>/dev/null; then
    kill "$display_helper_pid" 2>/dev/null || true
    wait "$display_helper_pid" 2>/dev/null || true
  fi
}
trap cleanup_display_helper EXIT

if [[ "$vm_auto_display" == 1 ]]; then
  "$project_root/scripts/set-vm-display" "$qmp_socket" "$monitor_socket" \
    "$vm_width" "$vm_height" "$vm_scale" "$vm_refresh" "$vm_display_delay" &
  display_helper_pid=$!
  printf 'VM backend %s, display profile %s: %sx%s at %s%% scale (automatic verification pending).\n' "$vm_backend" \
    "$vm_profile" "$vm_width" "$vm_height" "$(awk "BEGIN { print $vm_scale * 100 }")"
else
  printf 'Automatic VM display selection disabled. Apply it with:\n'
  printf '  scripts/set-vm-display %q %q %q %q %q %q\n' \
    "$qmp_socket" "$monitor_socket" "$vm_width" "$vm_height" "$vm_scale" "$vm_refresh"
fi

if [[ "$vm_backend" == gtk ]]; then
  printf 'Local PM-review window is resizable with zoom-to-fit enabled; maximise it normally to fill the screen.\n'
else
  printf 'VNC backend is automation-only; it does not open a local PM-review window.\n'
fi

wait "$qemu_pid"
