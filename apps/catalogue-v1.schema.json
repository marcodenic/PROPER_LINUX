{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema", "version", "entries"],
  "properties": {
    "schema": {"const": "org.properlinux.catalogue"},
    "version": {"const": 1},
    "entries": {"type": "array", "items": {"type": "object", "required": ["id", "name", "category", "description", "homepage", "provider", "provider_id", "status", "license", "architectures", "launch_args"], "properties": {
      "id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "name": {"type": "string"}, "category": {"type": "string"}, "description": {"type": "string"}, "homepage": {"type": "string", "format": "uri"}, "provider": {"enum": ["fedora", "flatpak", "vendor"]}, "provider_id": {"type": "string"}, "status": {"type": "string"}, "license": {"type": "string"}, "architectures": {"type": "array", "items": {"type": "string"}}, "launch_args": {"type": "array", "items": {"type": "string"}},
      "install_steps": {"type": "array", "items": {"type": "object", "required": ["program", "args", "privileged"], "properties": {"program": {"type": "string"}, "args": {"type": "array", "items": {"type": "string"}}, "privileged": {"type": "boolean"}}}}
    }}}
  }
}
